import ArithmeticTeichmullerSpaces.Act1Scene1.IutInitialThetaLocalH1LogOrdinaryWitnessBridge
import ArithmeticTeichmullerSpaces.Act1Scene1.IutInitialThetaOrdinaryLogCollation

namespace JoshiTeich.Act1Scene1

open JoshiTeich.Prologue
open scoped Valued

universe u

noncomputable section

set_option maxHeartbeats 1000000

variable {AG : JoshiTeich.ReferenceIut.AnabelianGeometry.{u}}
variable {TG : JoshiTeich.ReferenceIut.TemperedGeometry AG}

/-!
source-id: JT-SCENE1-LOCAL-H1-LOG-ORDINARY-COLLATION-BRIDGE
source: the local H¹/log ordinary witness and the actual ordinary collation
laws from `IutInitialThetaOrdinaryLogCollation.lean`.
fidelity: constructs the singleton collation generated by the H¹/log ordinary
witness, proves its witness and normalization conditions, and transports the
ordinary collation volume and negative-log bounds to that source.
boundary: Scene1/Derived; this is an actual ordinary collation result. It does
not identify the collation with a paper theta locus, H¹ₑ/BK data, or a paper
`thetaVolume`.
-/

namespace InitialThetaLocalH1LogOrdinaryCollationBridge

variable (D : JoshiTeich.ReferenceIut.InitialThetaData AG TG) (n : ℕ)

abbrev packet (v : iutInitialThetaOddModSupportFinset D) :=
  OrdinaryKummerLogHull.packet D n v

local instance bridgePrime (v : iutInitialThetaOddModSupportFinset D) :
    Fact (Arithmetic.residueChar v.1).Prime :=
  ⟨Arithmetic.residueChar_prime v.1⟩

noncomputable def singletonCollation
    (v : iutInitialThetaOddModSupportFinset D) (_ : Unit) :
    Set (packet D n v).Tensor :=
  {InitialThetaLocalH1LogOrdinaryWitnessBridge.h1OrdinaryWitness D n v}

theorem singletonCollation_witness_mem
    (v : iutInitialThetaOddModSupportFinset D) :
    OrdinaryKummerLogHull.witness D n v ∈ ⋃ k, singletonCollation D n v k := by
  simp [singletonCollation,
    InitialThetaLocalH1LogOrdinaryWitnessBridge.h1OrdinaryWitness_eq_witness D n v]

theorem singletonCollation_subset_normalization
    (v : iutInitialThetaOddModSupportFinset D) (k : Unit) :
    singletonCollation D n v k ⊆ (packet D n v).normalization := by
  intro x hx
  simp only [singletonCollation, Set.mem_singleton_iff] at hx
  subst x
  rw [InitialThetaLocalH1LogOrdinaryWitnessBridge.h1OrdinaryWitness_eq_witness D n v]
  apply (packet D n v).unitLattice_le_normalization
  apply (packet D n v).pure_mem_lattice
  intro i
  rw [Metric.mem_closedBall, dist_zero_right]
  exact (OrdinaryKummerLogHull.norm_scalar_lt_one D _).le

theorem singletonCollation_laws :
    (∀ v, OrdinaryKummerLogHull.witness D n v ∈
      ⋃ k, singletonCollation D n v k) ∧
    (∀ v k, singletonCollation D n v k ⊆
      (packet D n v).normalization) :=
  ⟨singletonCollation_witness_mem D n, singletonCollation_subset_normalization D n⟩

theorem singletonCollation_region_eq_ordinary_region
    (v : iutInitialThetaOddModSupportFinset D) :
    (FullSupportWitnessHull.region D n (singletonCollation D n) v :
      Set (packet D n v).Tensor) =
      (OrdinaryKummerLogHull.region D n v : Set (packet D n v).Tensor) := by
  simp only [FullSupportWitnessHull.region, singletonCollation, Set.iUnion_const]
  rw [InitialThetaLocalH1LogOrdinaryWitnessBridge.h1OrdinaryWitness_eq_witness D n v]
  rfl

theorem singletonCollation_volume_pos :
    0 < FullSupportWitnessHull.volume D n (singletonCollation D n) :=
  OrdinaryKummerLogHull.ordinary_collation_volume_pos D n
    (singletonCollation D n)
    (singletonCollation_witness_mem D n)
    (singletonCollation_subset_normalization D n)

theorem singletonCollation_corrected_rootProduct_pow_le :
    OrdinaryKummerLogHull.correction D n * actualSelectedPaperRootNormProduct D ^ n ≤
      FullSupportWitnessHull.volume D n (singletonCollation D n) :=
  OrdinaryKummerLogHull.corrected_rootProduct_pow_le_collation D n
    (singletonCollation D n)
    (singletonCollation_witness_mem D n)
    (singletonCollation_subset_normalization D n)

theorem singletonCollation_averageAbsLog_le_correctedCost (hn : 0 < n) :
    (1 / (n : ℝ)) *
        |Real.log (FullSupportWitnessHull.volume D n (singletonCollation D n))| ≤
      FullSupportPaperWeightedHull.weightedPaperSum D -
        Real.log (OrdinaryKummerLogHull.correction D 1) :=
  OrdinaryKummerLogHull.ordinary_collation_averageAbsLog_le_correctedCost D n
    (singletonCollation D n)
    (singletonCollation_witness_mem D n)
    (singletonCollation_subset_normalization D n) hn

end InitialThetaLocalH1LogOrdinaryCollationBridge

end
end JoshiTeich.Act1Scene1
