import ArithmeticTeichmullerSpaces.Act1Scene1.NormalizationUniquePrime
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
source-id: JT-SCENE1-BOUNDARY-PRODUCER-CONTRACTS-20261021
source: the existing common-fraction-field denominator criterion and raw-origin
quotient generated by constants. Original elementary quotient-ring argument.
boundary: this does not identify upper division-cover residue fields with k.
-/
namespace JoshiTeich.Act1Scene1.NormalizationResidueConstants

open scoped Classical
noncomputable section

variable {k R A : Type*} [Field k] [CommRing R] [CommRing A]
  [Algebra k R] [Algebra R A] [Algebra k A] [IsScalarTower k R A]

/-- A denominator presentation outside the center does not enlarge its constant residue field. -/
theorem quotient_constants_surjective_of_denominators
    (p : Ideal R) [p.IsPrime] (q : Ideal A) [q.IsMaximal] [q.LiesOver p]
    (hconst : Function.Surjective (algebraMap k (R ⧸ p)))
    (hden : ∀ x : A, ∃ a : R, ∃ s : p.primeCompl,
      x * algebraMap R A s = algebraMap R A a) :
    Function.Surjective (algebraMap k (A ⧸ q)) := by
  letI : Field (A ⧸ q) := Ideal.Quotient.field q
  have hconstA (a : R) :
      ∃ c : k, algebraMap R (A ⧸ q) a = algebraMap k (A ⧸ q) c := by
    obtain ⟨c, hc⟩ := hconst (Ideal.Quotient.mk p a)
    change Ideal.Quotient.mk p (algebraMap k R c) = Ideal.Quotient.mk p a at hc
    have hd := (Ideal.Quotient.eq.mp hc)
    have hmem : algebraMap R A (algebraMap k R c - a) ∈ q :=
      (q.mem_of_liesOver p _).mp hd
    have he : Ideal.Quotient.mk q (algebraMap R A (algebraMap k R c)) =
        Ideal.Quotient.mk q (algebraMap R A a) := by
      apply Ideal.Quotient.eq.mpr
      simpa only [map_sub] using hmem
    refine ⟨c, ?_⟩
    rw [IsScalarTower.algebraMap_apply k R (A ⧸ q) c]
    exact he.symm
  intro z
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨a, s, hs⟩ := hden x
  obtain ⟨c, hc⟩ := hconstA a
  obtain ⟨d, hd⟩ := hconstA (s : R)
  have hd0 : algebraMap k (A ⧸ q) d ≠ 0 := by
    intro hz
    have hz' : algebraMap R (A ⧸ q) (s : R) = 0 := hd.trans hz
    change Ideal.Quotient.mk q (algebraMap R A (s : R)) = 0 at hz'
    exact s.property ((q.mem_of_liesOver p (s : R)).mpr
      (Ideal.Quotient.eq_zero_iff_mem.mp hz'))
  have hprod : Ideal.Quotient.mk q x * algebraMap k (A ⧸ q) d =
      algebraMap k (A ⧸ q) c := by
    have hh := congrArg (Ideal.Quotient.mk q) hs
    simp only [map_mul] at hh
    change Ideal.Quotient.mk q x * algebraMap R (A ⧸ q) (s : R) =
      algebraMap R (A ⧸ q) a at hh
    simpa only [hd, hc] using hh
  refine ⟨c / d, ?_⟩
  rw [map_div₀]
  exact ((eq_div_iff hd0).mpr hprod).symm

end
end JoshiTeich.Act1Scene1.NormalizationResidueConstants
