import ArithmeticTeichmullerSpaces.Act1Scene1.LocalPadicLogBall
import ArithmeticTeichmullerSpaces.Act1Scene1.IutInitialThetaLogWitness

/-!
source-id: JT-SCENE1-INITIAL-THETA-LOG-BALL
source: Joshi III, `le:volume-lemma2`, the local scalar lattices
`lambda * O_E`, and the actual canonical q-root logarithm witness.
fidelity: constructs a full scalar integral ball in the actual torsion
completion and proves log-shell containment and minimality among centered
norm balls. This does not construct the paper's tensor hull or its volume.
boundary: Scene1/Derived
-/

namespace JoshiTeich.Act1Scene1.InitialThetaLogWitness

open JoshiTeich.Prologue NumberField

universe u
noncomputable section

variable {AG : JoshiTeich.ReferenceIut.AnabelianGeometry.{u}}
variable {TG : JoshiTeich.ReferenceIut.TemperedGeometry AG}
variable (D : JoshiTeich.ReferenceIut.InitialThetaData AG TG)

/-- The integral scalar ball generated by the actual logarithm witness. -/
def integralBall (v : (IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).badFinset) :
    Set (v.1.maximalIdeal.adicCompletion ↥D.prime.torsionField) :=
  (fun x => value D v * x) '' Metric.closedBall 0 1

theorem integralBall_eq_closedBall
    (v : (IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).badFinset) :
    integralBall D v = Metric.closedBall 0
      ‖(IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).qroot v‖ := by
  rw [integralBall, LocalPadicLog.mul_image_closedBall _ (value_ne_zero D v),
    norm_value_eq_qroot_norm D v]

theorem value_mem_integralBall
    (v : (IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).badFinset) :
    value D v ∈ integralBall D v := by
  exact ⟨1, by simp, mul_one _⟩

theorem integralBall_subset_logShell
    (v : (IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).badFinset) :
    integralBall D v ⊆ LocalPadicLog.logShell
      (k := v.1.maximalIdeal.adicCompletion ↥D.prime.torsionField)
      (Arithmetic.residueChar v.1) := by
  letI : CharZero (v.1.maximalIdeal.adicCompletion ↥D.prime.torsionField) :=
    charZero_of_injective_ringHom (FinitePlace.embedding v.1.maximalIdeal).injective
  intro x hx
  apply LocalPadicLog.closedBall_subset_logShell
    (Arithmetic.residueChar_prime v.1) (norm_residueChar_lt_one v.1)
  rw [integralBall_eq_closedBall D v, Metric.mem_closedBall, dist_zero_right] at hx
  rw [Metric.mem_closedBall, dist_zero_right]
  exact hx.trans
    (IutTorsionQRootSource.ofInitialThetaDataFromGlobal_qroot_norm_lt_one D v).le

/-- Any centered norm ball containing the witness contains its entire integral ball. -/
theorem integralBall_subset_closedBall_iff
    (v : (IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).badFinset) (r : ℝ) :
    integralBall D v ⊆ Metric.closedBall 0 r ↔ value D v ∈ Metric.closedBall 0 r := by
  constructor
  · intro h
    exact h (value_mem_integralBall D v)
  · intro h x hx
    rw [Metric.mem_closedBall, dist_zero_right, norm_value_eq_qroot_norm D v] at h
    rw [integralBall_eq_closedBall D v, Metric.mem_closedBall, dist_zero_right] at hx
    rw [Metric.mem_closedBall, dist_zero_right]
    exact hx.trans h

end
end JoshiTeich.Act1Scene1.InitialThetaLogWitness
