namespace JoshiTeich.Act1Scene1.InitialThetaWittNormalizedOrbitProductThetaKernel

open JoshiTeich.Prologue InitialThetaWittAllRadiusCompletion
open InitialThetaWittNormalizedOrbitProduct InitialThetaWittThetaPrincipalKernel
open InitialThetaWittThetaEvaluation InitialThetaWittThetaBound
open Filter
open scoped Topology
noncomputable section
universe u
variable {AG : JoshiTeich.ReferenceIut.AnabelianGeometry.{u}}
variable {TG : JoshiTeich.ReferenceIut.TemperedGeometry AG}
variable (D : JoshiTeich.ReferenceIut.InitialThetaData AG TG)
variable (w : (iutInitialThetaTateParameterData D).places)

local instance selectedPrime : Fact (Arithmetic.residueChar w.1).Prime :=
  ⟨Arithmetic.residueChar_prime w.1⟩

theorem evaluation_factor_zero : evaluation D w (factor D w 0) = 0 := by
  simp only [factor, InitialThetaWittFrobeniusThetaOrbit.primitiveOrbit_zero,
    map_mul, evaluation_primitive, mul_zero]

theorem evaluation_partialProduct_eq_zero_eventually :
    ∀ᶠ N : ℕ in atTop, evaluation D w (partialProduct D w N) = 0 := by
  refine eventually_atTop.2 ⟨1, ?_⟩
  intro N hN
  change evaluation D w (∏ n ∈ Finset.range N, factor D w n) = 0
  rw [map_prod]
  exact Finset.prod_eq_zero (Finset.mem_range.mpr (by omega))
    (evaluation_factor_zero D w)

theorem evaluation_product_eq_zero : evaluation D w (product D w) = 0 := by
  have hcont := ((InitialThetaWittThetaEvaluation.evaluation_continuous D w).tendsto
    (product D w)).comp (partial_tendsto D w)
  have hzero : Tendsto (fun _ : ℕ => (0 : Untilt D w)) atTop (𝓝 0) := tendsto_const_nhds
  have heq : (fun _ : ℕ => (0 : Untilt D w)) =ᶠ[atTop]
      (fun N => evaluation D w (partialProduct D w N)) :=
    (evaluation_partialProduct_eq_zero_eventually D w).mono fun _ h => h.symm
  exact tendsto_nhds_unique hcont (hzero.congr' heq)

theorem existsUnique_primitive_product_quotient :
    ∃! y : Carrier D w, primitive D w * y = product D w :=
  existsUnique_primitive_quotient D w (product D w) (evaluation_product_eq_zero D w)

end
end JoshiTeich.Act1Scene1.InitialThetaWittNormalizedOrbitProductThetaKernel
