import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.RingTheory.Localization.FractionRing

/-!
source-id: JT-SCENE1-BOUNDARY-PRODUCER-CONTRACTS-20261021
source: IUT I Definition 3.1(d),(f); Joshi III `ss:theta-data-fixing2`.
fidelity: the actual coordinate subalgebra has the original fraction field once its images generate that field.
Original proofs; no reference implementation copied.
boundary: this does not identify the infinity fiber with a projective cusp,
`AG.Cusp`, the distinguished torsion class or the theta-root model.
-/
namespace JoshiTeich.Act1Scene1.AdjoinSubringFractionField

open scoped IntermediateField.algebraAdjoinAdjoin

variable {k R F : Type*} [Field k] [CommRing R] [IsDomain R] [Field F]
  [Algebra k R] [Algebra k F] [Algebra R F] [IsScalarTower k R F]
  [FaithfulSMul R F]

/-- The image of the actual subalgebra generated inside R is precisely the
subalgebra generated by its original images in F. -/
theorem map_adjoin (s : Set R) :
    (Algebra.adjoin k s).map (IsScalarTower.toAlgHom k R F) =
      Algebra.adjoin k (algebraMap R F '' s) := by
  exact AlgHom.map_adjoin (IsScalarTower.toAlgHom k R F) s

/-- Field generation by original images suffices for the fraction-field
property of the actual subalgebra inside R. -/
theorem isFractionRing_adjoin_of_field_adjoin_eq_top (s : Set R)
    (hgen : IntermediateField.adjoin k (algebraMap R F '' s) = ⊤) :
    IsFractionRing (Algebra.adjoin k s) F := by
  let B := Algebra.adjoin k s
  let φ : R →ₐ[k] F := IsScalarTower.toAlgHom k R F
  have hmap : B.map φ = Algebra.adjoin k (algebraMap R F '' s) :=
    map_adjoin s
  apply IsFractionRing.of_field
  intro z
  have hz : z ∈ IntermediateField.adjoin k (algebraMap R F '' s) := by
    rw [hgen]
    trivial
  obtain ⟨a, ha, b, hb, hab⟩ := IntermediateField.mem_adjoin_iff_div.mp hz
  rw [← hmap] at ha hb
  obtain ⟨aR, haR, haeq⟩ := Subalgebra.mem_map.mp ha
  obtain ⟨bR, hbR, hbeq⟩ := Subalgebra.mem_map.mp hb
  refine ⟨⟨aR, haR⟩, ⟨bR, hbR⟩, ?_⟩
  change z = φ aR / φ bR
  rw [haeq, hbeq]
  exact hab

/-- The two-coordinate specialization has exactly the actual algebraMap
images as generators, with no separately supplied image comparison. -/
theorem isFractionRing_adjoin_pair (u v : R)
    (hgen : IntermediateField.adjoin k
      ({algebraMap R F u, algebraMap R F v} : Set F) = ⊤) :
    IsFractionRing (Algebra.adjoin k ({u, v} : Set R)) F := by
  apply isFractionRing_adjoin_of_field_adjoin_eq_top
  simpa only [Set.image_insert_eq, Set.image_singleton] using hgen

end JoshiTeich.Act1Scene1.AdjoinSubringFractionField
