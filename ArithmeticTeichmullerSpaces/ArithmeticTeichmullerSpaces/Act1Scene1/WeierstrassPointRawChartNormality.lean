namespace JoshiTeich.Act1Scene1.WeierstrassPointRawChartNormality

open WeierstrassCurve Polynomial
open JoshiTeich.ReferenceIut.Anabelian
open WeierstrassTranscendentalPointEvaluation
open scoped Classical
noncomputable section
universe u v

variable {k : Type u} [Field k]
  (E : WeierstrassCurve k) [E.IsElliptic]
  {K : Type v} [Field K] [Algebra k K]

/-- The actual affine chart generated by both coordinates of the supplied point. -/
abbrev rawChart (P : (E⁄K).toAffine.Point) : Subalgebra k K :=
  Algebra.adjoin k ({ptX P, ptY P} : Set K)

/-- Coordinate evaluation has exactly the actual two-coordinate image. -/
theorem coordinateAlgHom_range_eq_rawChart
    (P : (E⁄K).toAffine.Point) (hP : P ≠ 0) :
    (coordinateAlgHom E P hP).range = rawChart E P := by
  let f := coordinateAlgHom E P hP
  let B := rawChart E P
  have hx : f (Affine.CoordinateRing.mk E.toAffine (C Polynomial.X)) ∈ B := by
    rw [show f (Affine.CoordinateRing.mk E.toAffine (C Polynomial.X)) = ptX P from
      coordinateAlgHom_X E P hP]
    exact Algebra.subset_adjoin (by simp)
  have hy : f (Affine.CoordinateRing.mk E.toAffine Polynomial.X) ∈ B := by
    rw [show f (Affine.CoordinateRing.mk E.toAffine Polynomial.X) = ptY P from
      coordinateAlgHom_Y E P hP]
    exact Algebra.subset_adjoin (by simp)
  apply le_antisymm
  · rintro z ⟨a, rfl⟩
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective a
    induction p using Polynomial.induction_on with
    | C q =>
      induction q using Polynomial.induction_on with
      | C c =>
        have hc : f (AdjoinRoot.mk E.toAffine.polynomial (C (C c))) =
            algebraMap k K c := by
          change f (algebraMap k E.toAffine.CoordinateRing c) = _
          exact f.commutes c
        change f (AdjoinRoot.mk E.toAffine.polynomial (C (C c))) ∈ B
        rw [hc]
        exact B.algebraMap_mem c
      | add q r hq hr => simpa only [C_add, map_add] using B.add_mem hq hr
      | monomial m c hc =>
        -- induction_on advances C c * X^m to C c * X^(m+1).
        rw [pow_succ, ← mul_assoc, C_mul, map_mul, map_mul]
        exact B.mul_mem hc hx
    | add p q hp hq => simpa only [map_add] using B.add_mem hp hq
    | monomial m q hq =>
      -- The outer polynomial has the same power-successor induction step.
      rw [pow_succ, ← mul_assoc, map_mul, map_mul]
      exact B.mul_mem hq hy
  · apply Algebra.adjoin_le
    intro z hz
    rcases hz with rfl | rfl
    · exact ⟨Affine.CoordinateRing.mk E.toAffine (C Polynomial.X),
        coordinateAlgHom_X E P hP⟩
    · exact ⟨Affine.CoordinateRing.mk E.toAffine Polynomial.X,
        coordinateAlgHom_Y E P hP⟩

/-- Transcendence identifies the original coordinate ring with this same raw chart. -/
def coordinateRawChartEquiv
    (P : (E⁄K).toAffine.Point) (hP : P ≠ 0) (hx : Transcendental k (ptX P)) :
    E.toAffine.CoordinateRing ≃ₐ[k] rawChart E P :=
  (AlgEquiv.ofInjective (coordinateAlgHom E P hP)
    (coordinateAlgHom_injective E P hP hx)).trans
    (Subalgebra.equivOfEq _ _ (coordinateAlgHom_range_eq_rawChart E P hP))

/-- The actual raw chart is normal by the existing Weierstrass coordinate-ring theorem. -/
theorem rawChart_isIntegrallyClosed [CharZero k]
    (P : (E⁄K).toAffine.Point) (hP : P ≠ 0) (hx : Transcendental k (ptX P)) :
    IsIntegrallyClosed (rawChart E P) := by
  letI : IsIntegrallyClosed E.toAffine.CoordinateRing :=
    Genuine.coordinateRing_isIntegrallyClosed E
  exact IsIntegrallyClosed.of_equiv (coordinateRawChartEquiv E P hP hx).toRingEquiv

/-- In particular the actual raw chart is normal at every actual prime center. -/
theorem rawChart_atPrime_isIntegrallyClosed [CharZero k]
    (P : (E⁄K).toAffine.Point) (hP : P ≠ 0) (hx : Transcendental k (ptX P))
    (p : Ideal (rawChart E P)) [p.IsPrime] :
    IsIntegrallyClosed (Localization.AtPrime p) := by
  letI : IsIntegrallyClosed (rawChart E P) := rawChart_isIntegrallyClosed E P hP hx
  exact isIntegrallyClosed_of_isLocalization (Localization.AtPrime p)
    p.primeCompl p.primeCompl_le_nonZeroDivisors

end
end JoshiTeich.Act1Scene1.WeierstrassPointRawChartNormality
