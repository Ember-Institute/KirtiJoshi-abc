import ArithmeticTeichmullerSpaces.Act1Scene1.IutInitialThetaTensorWitness
import ArithmeticTeichmullerSpaces.Act1Scene1.LocalCompletionTensorTopology

/-!
source-id: JT-SCENE1-INITIAL-THETA-TENSOR-REGION-TOPOLOGY
source: Joshi III `le:volume-lemma2`, `le:volume-lemma3`; actual completion
tensor lattice generated by canonical q-root logarithm integral balls.
fidelity: proves compact openness and positive finite Haar measure in the
actual finite-dimensional tensor topology. It does not compute tensor
measure, identify a hull or provide different-untilt theta values.
boundary: Scene1/Derived
-/

namespace JoshiTeich.Act1Scene1.InitialThetaTensorWitness

open JoshiTeich.Prologue NumberField MeasureTheory

universe u
noncomputable section
variable {AG : JoshiTeich.ReferenceIut.AnabelianGeometry.{u}}
variable {TG : JoshiTeich.ReferenceIut.TemperedGeometry AG}
variable (D : JoshiTeich.ReferenceIut.InitialThetaData AG TG)
variable (p : ℕ) [Fact p.Prime] {ι : Type} [Fintype ι]
variable (c : ι → (IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).badFinset)
variable (hc : ∀ i, Arithmetic.residueChar (c i).1 = p)

theorem region_eq_ballLattice : region D p c hc =
    (packet D p c hc).lattice (fun i => Metric.closedBall 0
      ‖(IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).qroot (c i)‖) := by
  unfold region
  congr 1
  funext i
  exact InitialThetaLogWitness.integralBall_eq_closedBall D (c i)

theorem region_isOpen : IsOpen (region D p c hc : Set (packet D p c hc).Tensor) := by
  rw [region_eq_ballLattice]
  apply LocalCompletion.Packet.lattice_balls_isOpen
  intro i
  exact norm_pos_iff.mpr
    ((IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).qroot_ne_zero (c i))

theorem region_isCompact : IsCompact (region D p c hc : Set (packet D p c hc).Tensor) := by
  rw [region_eq_ballLattice]
  apply LocalCompletion.Packet.lattice_balls_isCompact
  · intro i
    exact norm_pos_iff.mpr
      ((IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).qroot_ne_zero (c i))
  · intro i
    exact (IutTorsionQRootSource.ofInitialThetaDataFromGlobal_qroot_norm_lt_one D (c i)).le

theorem region_haar_pos_lt_top :
    0 < (packet D p c hc).haar (region D p c hc) ∧
      (packet D p c hc).haar (region D p c hc) < ⊤ := by
  rw [region_eq_ballLattice]
  apply LocalCompletion.Packet.lattice_balls_haar_pos_lt_top
  · intro i
    exact norm_pos_iff.mpr
      ((IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).qroot_ne_zero (c i))
  · intro i
    exact (IutTorsionQRootSource.ofInitialThetaDataFromGlobal_qroot_norm_lt_one D (c i)).le

end
end JoshiTeich.Act1Scene1.InitialThetaTensorWitness
