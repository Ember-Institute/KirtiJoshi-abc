import ArithmeticTeichmullerSpaces.Act1Scene1.GenuineInertiaConjugation
import ArithmeticTeichmullerSpaces.Act1Scene1.GenuineSignedQuotient
import ArithmeticTeichmullerSpaces.Act1Scene1.ClosedNormalQuotientMap

/-!
source-id: JT-SCENE1-GENUINE-VALUATION-INERTIA-QUOTIENT
source: IUT I Definition 3.1(d); Joshi III `ss:theta-data-fixing2`.
fidelity: closed normal valuation-inertia subgroup of the actual function-field
Galois group, its containment in every actual division-cover subgroup, and the
cover-induced continuous open embeddings of the original topological quotients.
The proofs are original to this project and use the proved generator comparison,
ambient conjugation stability, and actual division-cover subgroup inclusions.
boundary: Scene1/Derived. These are function-field inertia quotients. An etale
fundamental-group comparison, geometric realization, Cartesian covering, core,
theta-root, and InitialThetaGeometryProducer obligations remain separate.
-/

namespace JoshiTeich.ReferenceIut.Anabelian.Genuine

open WeierstrassCurve JoshiTeich.Act1Scene1
open scoped Classical Topology
universe u
noncomputable section

variable {k : Type u} [Field k] [CharZero k]
  (E : WeierstrassCurve k) [E.IsElliptic]

/-- Ambient conjugation adds no generators to the actual base inertia set. -/
theorem conjugatesOfSet_baseValuationInertiaGenerators :
    Group.conjugatesOfSet (baseValuationInertiaGenerators E) =
      baseValuationInertiaGenerators E := by
  apply Set.Subset.antisymm
  · intro σ hσ
    obtain ⟨τ, hτ, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hσ
    obtain ⟨h, rfl⟩ := isConj_iff.mp hconj
    exact baseValuationInertiaGenerators_conj_mem E h τ hτ
  · exact Group.subset_conjugatesOfSet

/-- Normal generation and subgroup generation agree for the actual inertia set. -/
theorem normalClosure_baseValuationInertiaGenerators_eq_closure :
    Subgroup.normalClosure (baseValuationInertiaGenerators E) =
      Subgroup.closure (baseValuationInertiaGenerators E) := by
  rw [Subgroup.normalClosure, conjugatesOfSet_baseValuationInertiaGenerators E]

/-- The closed normal subgroup generated by actual base valuation inertia. -/
def valuationInertiaSubgroup : Subgroup (Gal E) :=
  (Subgroup.normalClosure (baseValuationInertiaGenerators E)).topologicalClosure

instance valuationInertiaSubgroup_normal : (valuationInertiaSubgroup E).Normal :=
  Subgroup.is_normal_topologicalClosure _

theorem isClosed_valuationInertiaSubgroup :
    IsClosed (valuationInertiaSubgroup E : Set (Gal E)) :=
  Subgroup.isClosed_topologicalClosure _

theorem valuationInertiaSubgroup_eq_closure :
    valuationInertiaSubgroup E =
      (Subgroup.closure (baseValuationInertiaGenerators E)).topologicalClosure := by
  rw [valuationInertiaSubgroup, normalClosure_baseValuationInertiaGenerators_eq_closure E]

theorem baseValuationInertiaGenerators_subset_valuationInertiaSubgroup :
    baseValuationInertiaGenerators E ⊆ valuationInertiaSubgroup E := by
  intro σ hσ
  exact Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure hσ)

/-- The construction is the least closed normal subgroup containing the generators. -/
theorem valuationInertiaSubgroup_minimal (J : Subgroup (Gal E)) [J.Normal]
    (hJ : IsClosed (J : Set (Gal E)))
    (hS : baseValuationInertiaGenerators E ⊆ J) : valuationInertiaSubgroup E ≤ J :=
  Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal hS) hJ

/-- No conjugation outside a cover subgroup introduces additional killed elements. -/
theorem valuationInertiaSubgroup_le_Hgp (ell : ℕ)
    (M : AddSubgroup E.toAffine.Point) (pm : Bool) :
    valuationInertiaSubgroup E ≤ Hgp E ell M pm := by
  rw [valuationInertiaSubgroup_eq_closure E]
  apply Subgroup.topologicalClosure_minimal _
    ?_ (isClosed_Hgp E ell M pm)
  rw [Subgroup.closure_le]
  intro σ hσ
  rcases hσ with ⟨hG, W, hk, hx, hI⟩
  exact Hgp_false_le E ell M pm
    (valuationInertia_mem_unsignedGroup E σ W hk hx hI hG ell M)

/-- Every actual unsigned cover gives the same closed normal inertia subgroup. -/
theorem valuationInertiaSubgroup_eq_unsignedNormalClosure (ell : ℕ)
    (M : AddSubgroup E.toAffine.Point) :
    valuationInertiaSubgroup E =
      (Subgroup.normalClosure (unsignedValuationInertiaGenerators E ell M)).topologicalClosure := by
  rw [unsignedValuationInertiaGenerators_eq_base E ell M]
  rfl

theorem valuationInertiaSubgroup_eq_unsignedClosure (ell : ℕ)
    (M : AddSubgroup E.toAffine.Point) :
    valuationInertiaSubgroup E =
      (Subgroup.closure (unsignedValuationInertiaGenerators E ell M)).topologicalClosure := by
  rw [unsignedValuationInertiaGenerators_eq_base E ell M]
  exact valuationInertiaSubgroup_eq_closure E

/-- The common ambient inertia subgroup, restricted to the actual cover group. -/
def inertiaKernel (ell : ℕ) (M : AddSubgroup E.toAffine.Point) (pm : Bool) :
    Subgroup (Hgp E ell M pm) :=
  (valuationInertiaSubgroup E).subgroupOf (Hgp E ell M pm)

instance inertiaKernel_normal (ell : ℕ) (M : AddSubgroup E.toAffine.Point) (pm : Bool) :
    (inertiaKernel E ell M pm).Normal := by
  unfold inertiaKernel
  infer_instance

/-- Actual division-cover group modulo closed valuation inertia, with its quotient topology. -/
abbrev inertiaQuotient (ell : ℕ) (M : AddSubgroup E.toAffine.Point) (pm : Bool) :=
  Hgp E ell M pm ⧸ inertiaKernel E ell M pm

/-- A proved division-cover inclusion descends through the common inertia subgroup. -/
def inertiaQuotientMap {n ell ell' : ℕ} (hn : 0 < n)
    (hℓ : n * ell' = ell) {M M' : AddSubgroup E.toAffine.Point}
    (hM : ∀ P ∈ M, n • P ∈ M') {pm pm' : Bool}
    (hpm : pm = true → pm' = true) :
    inertiaQuotient E ell M pm →* inertiaQuotient E ell' M' pm' :=
  ClosedNormalQuotientMap.quotientMap (valuationInertiaSubgroup E)
    (Hgp_le E hn hℓ hM hpm)

@[simp] theorem inertiaQuotientMap_mk {n ell ell' : ℕ} (hn : 0 < n)
    (hℓ : n * ell' = ell) {M M' : AddSubgroup E.toAffine.Point}
    (hM : ∀ P ∈ M, n • P ∈ M') {pm pm' : Bool}
    (hpm : pm = true → pm' = true) (x : Hgp E ell M pm) :
    inertiaQuotientMap E hn hℓ hM hpm (QuotientGroup.mk x) =
      QuotientGroup.mk (Subgroup.inclusion (Hgp_le E hn hℓ hM hpm) x) := by
  rfl

theorem inertiaQuotientMap_continuous {n ell ell' : ℕ} (hn : 0 < n)
    (hℓ : n * ell' = ell) {M M' : AddSubgroup E.toAffine.Point}
    (hM : ∀ P ∈ M, n • P ∈ M') {pm pm' : Bool}
    (hpm : pm = true → pm' = true) :
    Continuous (inertiaQuotientMap E hn hℓ hM hpm) :=
  ClosedNormalQuotientMap.continuous_map (valuationInertiaSubgroup E)
    (Hgp_le E hn hℓ hM hpm)

theorem inertiaQuotientMap_isOpenEmbedding {n ell ell' : ℕ} (hn : 0 < n)
    (hℓ : n * ell' = ell) {M M' : AddSubgroup E.toAffine.Point}
    (hM : ∀ P ∈ M, n • P ∈ M') {pm pm' : Bool}
    (hpm : pm = true → pm' = true) :
    Topology.IsOpenEmbedding (inertiaQuotientMap E hn hℓ hM hpm) :=
  ClosedNormalQuotientMap.isOpenEmbedding_map (valuationInertiaSubgroup E)
    (Hgp_le E hn hℓ hM hpm) (isOpen_Hgp E ell M pm)

/-- The same-level unsigned-to-signed inclusion descends to the actual inertia quotients. -/
def unsignedToSignedInertiaQuotientMap (ell : ℕ)
    (M : AddSubgroup E.toAffine.Point) :
    inertiaQuotient E ell M false →* inertiaQuotient E ell M true :=
  ClosedNormalQuotientMap.quotientMap (valuationInertiaSubgroup E)
    (Hgp_false_le E ell M true)

@[simp] theorem unsignedToSignedInertiaQuotientMap_mk (ell : ℕ)
    (M : AddSubgroup E.toAffine.Point) (x : Hgp E ell M false) :
    unsignedToSignedInertiaQuotientMap E ell M (QuotientGroup.mk x) =
      QuotientGroup.mk (Subgroup.inclusion (Hgp_false_le E ell M true) x) := by
  rfl

theorem unsignedToSignedInertiaQuotientMap_continuous (ell : ℕ)
    (M : AddSubgroup E.toAffine.Point) :
    Continuous (unsignedToSignedInertiaQuotientMap E ell M) :=
  ClosedNormalQuotientMap.continuous_map (valuationInertiaSubgroup E)
    (Hgp_false_le E ell M true)

theorem unsignedToSignedInertiaQuotientMap_isOpenEmbedding (ell : ℕ)
    (M : AddSubgroup E.toAffine.Point) :
    Topology.IsOpenEmbedding (unsignedToSignedInertiaQuotientMap E ell M) :=
  ClosedNormalQuotientMap.isOpenEmbedding_map (valuationInertiaSubgroup E)
    (Hgp_false_le E ell M true) (isOpen_Hgp E ell M false)

end
end JoshiTeich.ReferenceIut.Anabelian.Genuine
