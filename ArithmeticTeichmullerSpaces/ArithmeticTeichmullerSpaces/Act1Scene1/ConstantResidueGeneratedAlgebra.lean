import ArithmeticTeichmullerSpaces.Act1Scene1.ValuationResidueCoefficients
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed

/-!
source-id: JT-SCENE1-BOUNDARY-PRODUCER-CONTRACTS-20261021
source: IUT I Definition 3.1(d),(f); Joshi III `ss:theta-data-fixing2`;
the original integral coordinates and their constant residues.
fidelity: restricts the SAME valuation residue map to the algebra generated by
two given integral coordinates. Constant residues of the generators imply
constant residues of that whole algebra and a maximal kernel with constant
quotient. No fraction-field or normalization-residue identity is assumed.
Original elementary proofs; no reference implementation copied.
-/

namespace JoshiTeich.Act1Scene1.ConstantResidueGeneratedAlgebra

open ValuationResidueCoefficients
noncomputable section

variable {k K : Type*} [Field k] [Field K] [Algebra k K]
  (W : ValuationSubring K) (hk : ∀ c : k, algebraMap k K c ∈ W)
  (x y : K) (hx : x ∈ W) (hy : y ∈ W)

include hk hx hy in
/-- Every element generated by the original integral coordinates is integral at W. -/
theorem adjoin_pair_mem_valuation :
    ∀ z ∈ Algebra.adjoin k ({x, y} : Set K), z ∈ W := by
  intro z hz
  exact Algebra.adjoin_induction
    (fun z hz => by
      rcases Set.mem_insert_iff.mp hz with rfl | hz
      · exact hx
      · exact Set.mem_singleton_iff.mp hz ▸ hy)
    hk (fun a b _ _ ha hb => W.add_mem a b ha hb)
    (fun a b _ _ ha hb => W.mul_mem a b ha hb) hz

/-- The original inclusion of the generated algebra into the same valuation ring. -/
def valuationMap :
    letI := ringCoefficientAlgebra W hk
    Algebra.adjoin k ({x, y} : Set K) →ₐ[k] W := by
  letI := ringCoefficientAlgebra W hk
  exact
    { toFun := fun z => ⟨z.val, adjoin_pair_mem_valuation W hk x y hx hy z.val z.property⟩
      map_zero' := rfl
      map_one' := rfl
      map_add' := fun _ _ => rfl
      map_mul' := fun _ _ => rfl
      commutes' := fun _ => rfl }

/-- Restrict the original residue map; do not map the ambient field to its residue field. -/
def residueMap :
    letI := coefficientAlgebra W hk
    Algebra.adjoin k ({x, y} : Set K) →ₐ[k] residueField W := by
  letI := ringCoefficientAlgebra W hk
  exact (IsScalarTower.toAlgHom k W (residueField W)).comp
    (valuationMap W hk x y hx hy)

/-- The same residue map sends every element of the generated algebra to a constant. -/
theorem residueMap_constants
    (hrx : letI := coefficientAlgebra W hk
      ∃ a : k, algebraMap k (residueField W) a = IsLocalRing.residue W ⟨x, hx⟩)
    (hry : letI := coefficientAlgebra W hk
      ∃ b : k, algebraMap k (residueField W) b = IsLocalRing.residue W ⟨y, hy⟩) :
    letI := coefficientAlgebra W hk
    ∀ z : Algebra.adjoin k ({x, y} : Set K),
      ∃ c : k, algebraMap k (residueField W) c = residueMap W hk x y hx hy z := by
  letI := coefficientAlgebra W hk
  intro z
  refine Algebra.adjoin_induction
    (p := fun a ha => ∃ c : k, algebraMap k (residueField W) c =
      residueMap W hk x y hx hy ⟨a, ha⟩) ?_ ?_ ?_ ?_ z.property
  · intro a ha
    rcases Set.mem_insert_iff.mp ha with rfl | ha
    · exact hrx
    · rcases Set.mem_singleton_iff.mp ha with rfl
      exact hry
  · intro c
    exact ⟨c, ((residueMap W hk x y hx hy).commutes c).symm⟩
  · intro a b ha hb hca hcb
    obtain ⟨c, hc⟩ := hca
    obtain ⟨d, hd⟩ := hcb
    refine ⟨c + d, ?_⟩
    change algebraMap k (residueField W) (c + d) =
      residueMap W hk x y hx hy ((⟨a, ha⟩ : Algebra.adjoin k ({x, y} : Set K)) + ⟨b, hb⟩)
    rw [map_add, map_add, hc, hd]
  · intro a b ha hb hca hcb
    obtain ⟨c, hc⟩ := hca
    obtain ⟨d, hd⟩ := hcb
    refine ⟨c * d, ?_⟩
    change algebraMap k (residueField W) (c * d) =
      residueMap W hk x y hx hy ((⟨a, ha⟩ : Algebra.adjoin k ({x, y} : Set K)) * ⟨b, hb⟩)
    rw [map_mul, map_mul, hc, hd]

/-- Consume one paired coordinate certificate before actual large-type specialization. -/
theorem residueMap_constants_of_pair
    (hr : letI := coefficientAlgebra W hk
      ∃ a b : k,
        algebraMap k (residueField W) a = IsLocalRing.residue W ⟨x, hx⟩ ∧
        algebraMap k (residueField W) b = IsLocalRing.residue W ⟨y, hy⟩) :
    letI := coefficientAlgebra W hk
    ∀ z : Algebra.adjoin k ({x, y} : Set K),
      ∃ c : k, algebraMap k (residueField W) c = residueMap W hk x y hx hy z := by
  obtain ⟨a, b, ha, hb⟩ := hr
  exact residueMap_constants W hk x y hx hy ⟨a, ha⟩ ⟨b, hb⟩

variable {B F : Type*} [CommRing B] [Field F] [Algebra k B] [Algebra k F]

/-- A constant-valued residue map has a quotient generated by the original constants. -/
theorem quotient_kernel_algebraMap_surjective (f : B →ₐ[k] F)
    (hconst : ∀ z : B, ∃ c : k, algebraMap k F c = f z) :
    Function.Surjective (algebraMap k (B ⧸ RingHom.ker f)) := by
  intro z
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨c, hc⟩ := hconst a
  refine ⟨c, Ideal.Quotient.eq.mpr ?_⟩
  change f (algebraMap k B c - a) = 0
  rw [map_sub, f.commutes, hc, sub_self]

/-- Its kernel is the actual maximal center, since the quotient is the coefficient field. -/
theorem kernel_isMaximal (f : B →ₐ[k] F)
    (hconst : ∀ z : B, ∃ c : k, algebraMap k F c = f z) :
    (RingHom.ker f).IsMaximal := by
  let I : Ideal B := RingHom.ker f
  let Q := B ⧸ I
  letI hprime : I.IsPrime := RingHom.ker_isPrime f
  letI : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hprime.ne_top
  have hsurj : Function.Surjective (algebraMap k Q) :=
    quotient_kernel_algebraMap_surjective f hconst
  apply Ideal.Quotient.maximal_of_isField
  change IsField Q
  refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, ?_⟩
  intro z hz
  obtain ⟨c, rfl⟩ := hsurj z
  have hc : c ≠ 0 := by
    intro hc
    exact hz (by rw [hc, map_zero])
  refine ⟨algebraMap k Q c⁻¹, ?_⟩
  rw [← map_mul, mul_inv_cancel₀ hc, map_one]

/-- The exact coefficient-surjectivity proposition, elaborated over a generic chart. -/
def quotientConstants (f : B →ₐ[k] F) : Prop :=
  Function.Surjective (algebraMap k (B ⧸ RingHom.ker f))

/-- Package the same quotient theorem before specializing the original large chart. -/
theorem quotientConstants_of (f : B →ₐ[k] F)
    (hconst : ∀ z : B, ∃ c : k, algebraMap k F c = f z) : quotientConstants f :=
  quotient_kernel_algebraMap_surjective f hconst

/-- The exact local integral-closedness proposition at a supplied prime center. -/
def normalAt (I : Ideal B) (hI : I.IsPrime) : Prop :=
  letI : I.IsPrime := hI
  IsIntegrallyClosed (Localization.AtPrime I)

/-- Integral closedness localizes at that same original center. -/
theorem normalAt_of [IsDomain B] (I : Ideal B)
    (hN : IsIntegrallyClosed B) (hI : I.IsPrime) : normalAt I hI := by
  letI : IsIntegrallyClosed B := hN
  letI : I.IsPrime := hI
  exact isIntegrallyClosed_of_isLocalization (Localization.AtPrime I)
    I.primeCompl I.primeCompl_le_nonZeroDivisors

end
end JoshiTeich.Act1Scene1.ConstantResidueGeneratedAlgebra
