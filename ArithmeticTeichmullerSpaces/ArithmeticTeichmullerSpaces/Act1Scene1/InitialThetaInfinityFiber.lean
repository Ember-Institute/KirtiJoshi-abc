/-!
source-id: JT-SCENE1-INITIAL-THETA-INFINITY-NORMALIZATION-FIBER-20261107
source: IUT I Definition 3.1(d),(f); Joshi III `ss:theta-data-fixing2`;
the actual normalization and its inverse-coordinate valuation chart.
fidelity: rebases the same actual finite fixed fields to the chart
`k[u]`, where `u = xG⁻¹`, then constructs their finite nonempty prime fibers
over `u = 0`. The original signed field inclusion maps the unsigned fiber
surjectively onto the signed fiber, and `u` has valuation less than one at
every point of either fiber.
Original proofs; no reference implementation copied.
boundary: this constructs boundary closed-point carriers, but does not identify
them with `E[ℓ]/M`, the distinguished cusp, or a theta-root model.
-/

namespace JoshiTeich.Act1Scene1.InitialThetaGeometrySeed

open WeierstrassCurve Polynomial
open JoshiTeich.ReferenceIut JoshiTeich.ReferenceIut.Anabelian
open JoshiTeich.Act1Scene1.FunctionFieldNormalization
open scoped Classical IntermediateField.algebraAdjoinAdjoin
universe u
noncomputable section

attribute [local instance 1100] AdmissiblePrimeData.instDecidableEqK
variable {AG : AnabelianGeometry.{u}} {TG : TemperedGeometry AG}
variable (S : InitialThetaGeometrySeed AG TG)

private abbrev infinityCoefficientField := ↥S.prime.torsionField
private abbrev inverseCoordinate := (Genuine.xG S.prime.EK)⁻¹

private abbrev inverseCoordinateRationalBase :=
  rationalBase (infinityCoefficientField S) (inverseCoordinate S)

local instance inverseCoordinateRationalBase_coefficientAlgebra :
    Algebra (infinityCoefficientField S) (inverseCoordinateRationalBase S) :=
  IntermediateField.algebra' _

local instance inverseCoordinateRationalBase_coefficientSMul :
    SMul (infinityCoefficientField S) (inverseCoordinateRationalBase S) :=
  S.inverseCoordinateRationalBase_coefficientAlgebra.toSMul

local instance inverseCoordinateRationalBase_coefficientModule :
    Module (infinityCoefficientField S) (inverseCoordinateRationalBase S) :=
  S.inverseCoordinateRationalBase_coefficientAlgebra.toModule

private abbrev inverseCoordinatePolynomialBase :=
  FunctionFieldNormalization.polynomialBase
    (infinityCoefficientField S) (inverseCoordinate S)

private def inverseCoordinateBaseToRationalBase :
    inverseCoordinatePolynomialBase S →ₐ[infinityCoefficientField S]
      inverseCoordinateRationalBase S :=
  Subalgebra.inclusion (IntermediateField.algebra_adjoin_le_adjoin
    (infinityCoefficientField S) {inverseCoordinate S})

local instance inverseCoordinatePolynomialBaseRationalBaseAlgebra :
    Algebra (inverseCoordinatePolynomialBase S) (inverseCoordinateRationalBase S) :=
  S.inverseCoordinateBaseToRationalBase.toRingHom.toAlgebra

local instance inverseCoordinatePolynomialBaseRationalBaseSMul :
    SMul (inverseCoordinatePolynomialBase S) (inverseCoordinateRationalBase S) :=
  S.inverseCoordinatePolynomialBaseRationalBaseAlgebra.toSMul

local instance inverseCoordinatePolynomialBaseRationalBaseModule :
    Module (inverseCoordinatePolynomialBase S) (inverseCoordinateRationalBase S) :=
  S.inverseCoordinatePolynomialBaseRationalBaseAlgebra.toModule

local instance inverseCoordinatePolynomialBaseRationalBaseTower :
    IsScalarTower (inverseCoordinatePolynomialBase S) (inverseCoordinateRationalBase S)
      (Genuine.Ω S.prime.EK) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

private theorem inverseCoordinate_transcendental :
    Transcendental (infinityCoefficientField S) (inverseCoordinate S) := by
  intro h
  exact Genuine.transcendental_xG S.prime.EK
    ((IsAlgebraic.inv_iff (R := infinityCoefficientField S)
      (x := Genuine.xG S.prime.EK)).mp (by simpa using h))

/-- The same rational function field generated by `xG`, written in the infinity chart. -/
private theorem xLine_eq_inverseCoordinateLine :
    Genuine.xLine S.prime.EK =
      rationalBase (infinityCoefficientField S) (inverseCoordinate S) := by
  change IntermediateField.adjoin (infinityCoefficientField S) {Genuine.xG S.prime.EK} =
    IntermediateField.adjoin (infinityCoefficientField S) {inverseCoordinate S}
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro y hy
    simp only [Set.mem_singleton_iff] at hy
    subst y
    have hu : inverseCoordinate S ∈
        IntermediateField.adjoin (infinityCoefficientField S) {inverseCoordinate S} :=
      IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)
    simpa [inverseCoordinate] using
      (IntermediateField.adjoin (infinityCoefficientField S) {inverseCoordinate S}).inv_mem hu
  · apply IntermediateField.adjoin_le_iff.mpr
    intro y hy
    simp only [Set.mem_singleton_iff] at hy
    subst y
    have hx : Genuine.xG S.prime.EK ∈
        IntermediateField.adjoin (infinityCoefficientField S) {Genuine.xG S.prime.EK} :=
      IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)
    simpa [inverseCoordinate] using
      (IntermediateField.adjoin (infinityCoefficientField S) {Genuine.xG S.prime.EK}).inv_mem hx

/-- The original signed or unsigned fixed field in the inverse-coordinate naming. -/
def infinityNormalizationField (pm : Bool) :
    IntermediateField
      (rationalBase (infinityCoefficientField S) (inverseCoordinate S))
      (Genuine.Ω S.prime.EK) :=
  rebaseField S.xLine_eq_inverseCoordinateLine
    (Genuine.normalizationField S.prime.EK S.prime.ℓ S.prime.M pm)

theorem mem_infinityNormalizationField (pm : Bool) (x : Genuine.Ω S.prime.EK) :
    x ∈ S.infinityNormalizationField pm ↔
      x ∈ Genuine.normalizationField S.prime.EK S.prime.ℓ S.prime.M pm := Iff.rfl

local instance infinityNormalizationField_field (pm : Bool) :
    Field (S.infinityNormalizationField pm) :=
  (S.infinityNormalizationField pm).toSubfield.toField

local instance infinityNormalizationField_rationalBaseAlgebra (pm : Bool) :
    Algebra (inverseCoordinateRationalBase S) (S.infinityNormalizationField pm) :=
  IntermediateField.algebra' _

local instance infinityNormalizationField_baseAlgebra (pm : Bool) :
    Algebra (inverseCoordinatePolynomialBase S)
      (S.infinityNormalizationField pm) :=
  IntermediateField.algebra' _

local instance infinityNormalizationField_baseSMul (pm : Bool) :
    SMul (inverseCoordinatePolynomialBase S) (S.infinityNormalizationField pm) :=
  (S.infinityNormalizationField_baseAlgebra pm).toSMul

local instance infinityNormalizationField_baseModule (pm : Bool) :
    Module (inverseCoordinatePolynomialBase S) (S.infinityNormalizationField pm) :=
  (S.infinityNormalizationField_baseAlgebra pm).toModule

local instance infinityNormalizationField_coefficientAlgebra (pm : Bool) :
    Algebra (infinityCoefficientField S) (S.infinityNormalizationField pm) :=
  IntermediateField.algebra' _

local instance infinityNormalizationField_coefficientSMul (pm : Bool) :
    SMul (infinityCoefficientField S) (S.infinityNormalizationField pm) :=
  (S.infinityNormalizationField_coefficientAlgebra pm).toSMul

local instance infinityNormalizationField_coefficientModule (pm : Bool) :
    Module (infinityCoefficientField S) (S.infinityNormalizationField pm) :=
  (S.infinityNormalizationField_coefficientAlgebra pm).toModule

local instance infinityNormalizationField_coefficientBaseTower (pm : Bool) :
    IsScalarTower (infinityCoefficientField S) (inverseCoordinatePolynomialBase S)
      (S.infinityNormalizationField pm) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

local instance infinityNormalizationField_baseTower (pm : Bool) :
    IsScalarTower (inverseCoordinatePolynomialBase S) (inverseCoordinateRationalBase S)
      (S.infinityNormalizationField pm) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

instance finiteDimensional_infinityNormalizationField (pm : Bool) :
    FiniteDimensional
      (rationalBase (infinityCoefficientField S) (inverseCoordinate S))
      (S.infinityNormalizationField pm) :=
  finiteDimensional_rebaseField S.xLine_eq_inverseCoordinateLine _

instance separable_infinityNormalizationField (pm : Bool) :
    Algebra.IsSeparable
      (rationalBase (infinityCoefficientField S) (inverseCoordinate S))
      (S.infinityNormalizationField pm) := by
  have : Algebra.IsAlgebraic
      (rationalBase (infinityCoefficientField S) (inverseCoordinate S))
      (S.infinityNormalizationField pm) :=
    Algebra.IsAlgebraic.of_finite _ _
  have : CharZero
      (rationalBase (infinityCoefficientField S) (inverseCoordinate S)) :=
    charZero_of_injective_algebraMap
      (algebraMap (infinityCoefficientField S)
        (rationalBase (infinityCoefficientField S) (inverseCoordinate S))).injective
  exact Algebra.IsAlgebraic.isSeparable_of_perfectField

/-- The integral closure in the same actual field, now over the inverse-coordinate line. -/
abbrev infinityNormalizationRing (pm : Bool) :=
  FunctionFieldNormalization.coordRing (inverseCoordinate S) (S.infinityNormalizationField pm)

local instance infinityNormalizationRing_baseAlgebra (pm : Bool) :
    Algebra (inverseCoordinatePolynomialBase S) (S.infinityNormalizationRing pm) :=
  (S.infinityNormalizationRing pm).algebra

local instance infinityNormalizationRing_baseSMul (pm : Bool) :
    SMul (inverseCoordinatePolynomialBase S) (S.infinityNormalizationRing pm) :=
  (S.infinityNormalizationRing_baseAlgebra pm).toSMul

local instance infinityNormalizationRing_baseModule (pm : Bool) :
    Module (inverseCoordinatePolynomialBase S) (S.infinityNormalizationRing pm) :=
  (S.infinityNormalizationRing_baseAlgebra pm).toModule

local instance infinityNormalizationRing_coefficientAlgebra (pm : Bool) :
    Algebra (infinityCoefficientField S) (S.infinityNormalizationRing pm) :=
  (S.infinityNormalizationRing pm).algebra'

local instance infinityNormalizationRing_isDedekindDomain (pm : Bool) :
    IsDedekindDomain (S.infinityNormalizationRing pm) :=
  FunctionFieldNormalization.dedekindRing (inverseCoordinate S)
    S.inverseCoordinate_transcendental _

local instance infinityNormalizationRing_finite (pm : Bool) :
    Module.Finite
      (FunctionFieldNormalization.polynomialBase
        (infinityCoefficientField S) (inverseCoordinate S))
      (S.infinityNormalizationRing pm) :=
  FunctionFieldNormalization.finiteRing (inverseCoordinate S)
    S.inverseCoordinate_transcendental _

local instance infinityNormalizationRing_fractionField (pm : Bool) :
    IsFractionRing (S.infinityNormalizationRing pm) (S.infinityNormalizationField pm) :=
  FunctionFieldNormalization.fractionFieldRing (inverseCoordinate S) _

/-- The polynomial coordinate ring of the infinity chart. -/
abbrev infinityPolynomialBase := inverseCoordinatePolynomialBase S

/-- The inverse coordinate as an element of the infinity-chart base ring. -/
abbrev infinityCoordinate : S.infinityPolynomialBase :=
  polynomialCoordinate (inverseCoordinate S)

theorem coe_infinityCoordinate :
    (S.infinityCoordinate : Genuine.Ω S.prime.EK) = (Genuine.xG S.prime.EK)⁻¹ := rfl

/-- The closed point `u = 0` on the inverse-coordinate line. -/
abbrev infinityBaseIdeal : Ideal S.infinityPolynomialBase :=
  zeroBaseIdeal (inverseCoordinate S) S.inverseCoordinate_transcendental

theorem infinityBaseIdeal_isMaximal : S.infinityBaseIdeal.IsMaximal :=
  zeroBaseIdeal_isMaximal (inverseCoordinate S) S.inverseCoordinate_transcendental

theorem infinityBaseIdeal_ne_bot : S.infinityBaseIdeal ≠ ⊥ :=
  zeroBaseIdeal_ne_bot (inverseCoordinate S) S.inverseCoordinate_transcendental

theorem infinityCoordinate_mem_baseIdeal :
    S.infinityCoordinate ∈ S.infinityBaseIdeal :=
  polynomialCoordinate_mem_zeroBaseIdeal (inverseCoordinate S) S.inverseCoordinate_transcendental

/-- The actual boundary points at infinity are the primes over `u = 0`. -/
abbrev infinityFiber (pm : Bool) :=
  zeroFiber (inverseCoordinate S) S.inverseCoordinate_transcendental
    (S.infinityNormalizationField pm)

theorem infinityFiber_nonempty (pm : Bool) : Nonempty (S.infinityFiber pm) :=
  zeroFiber_nonempty (inverseCoordinate S) S.inverseCoordinate_transcendental
    (S.infinityNormalizationField pm)

theorem infinityFiber_finite (pm : Bool) : (S.infinityFiber pm).Finite :=
  zeroFiber_finite (inverseCoordinate S) S.inverseCoordinate_transcendental
    (S.infinityNormalizationField pm)

private theorem infinityNormalizationField_signed_le_unsigned :
    S.infinityNormalizationField true ≤ S.infinityNormalizationField false :=
  rebaseField_mono S.xLine_eq_inverseCoordinateLine
    (Genuine.normalizationField_signed_le_unsigned S.prime.EK S.prime.ℓ S.prime.M)

/-- The signed inclusion of the two actual infinity-chart normalization rings. -/
def infinityNormalizationRingMap :
    S.infinityNormalizationRing true →ₐ[infinityCoefficientField S]
      S.infinityNormalizationRing false :=
  ringMap S.infinityNormalizationField_signed_le_unsigned

theorem coe_infinityNormalizationRingMap (a : S.infinityNormalizationRing true) :
    ((S.infinityNormalizationRingMap a : S.infinityNormalizationField false) :
      Genuine.Ω S.prime.EK) =
    ((a : S.infinityNormalizationField true) : Genuine.Ω S.prime.EK) := rfl

/-- Restriction of infinity primes along the same actual signed field inclusion. -/
def infinityFiberMap : S.infinityFiber false → S.infinityFiber true :=
  zeroFiberMap S.inverseCoordinate_transcendental S.infinityNormalizationField_signed_le_unsigned

theorem infinityFiberMap_asIdeal (q : S.infinityFiber false) :
    (S.infinityFiberMap q).1 = q.1.comap S.infinityNormalizationRingMap.toRingHom := rfl

theorem infinityFiberMap_surjective : Function.Surjective S.infinityFiberMap :=
  zeroFiberMap_surjective S.inverseCoordinate_transcendental
    S.infinityNormalizationField_signed_le_unsigned

/-- An infinity-fiber prime as a nonzero Dedekind prime of the new normalization. -/
def infinityFiberHeightOne (pm : Bool) (q : S.infinityFiber pm) :
    IsDedekindDomain.HeightOneSpectrum (S.infinityNormalizationRing pm) :=
  zeroFiberHeightOne (inverseCoordinate S) S.inverseCoordinate_transcendental
    (S.infinityNormalizationField pm) q

theorem infinityInverseCoordinate_valuation_lt_one
    (pm : Bool) (q : S.infinityFiber pm) :
    (NormalizationPrimeValuation.primeSubring (S.infinityNormalizationField pm)
      (S.infinityFiberHeightOne pm q)).valuation
      (algebraMap (S.infinityNormalizationRing pm) (S.infinityNormalizationField pm)
        (algebraMap S.infinityPolynomialBase (S.infinityNormalizationRing pm)
          S.infinityCoordinate)) < 1 :=
  zeroFiber_coordinate_valuation_lt_one (inverseCoordinate S)
    S.inverseCoordinate_transcendental (S.infinityNormalizationField pm) q

end
end JoshiTeich.Act1Scene1.InitialThetaGeometrySeed
