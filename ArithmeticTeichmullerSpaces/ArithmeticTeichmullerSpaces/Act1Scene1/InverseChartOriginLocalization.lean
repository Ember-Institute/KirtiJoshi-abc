namespace JoshiTeich.Act1Scene1.InverseChartOriginLocalization

variable {R : Type*} [CommRing R]

def originFactor (u v a₁ a₂ a₃ a₄ a₆ : R) : R :=
  1 + a₂ * u + a₄ * u ^ 2 + a₆ * u ^ 3 - a₁ * v - a₃ * u * v

/-- The factor multiplying `u` is congruent to `1` at the origin. -/
theorem originFactor_notMem
    (m : Ideal R) [m.IsPrime] (u v a₁ a₂ a₃ a₄ a₆ : R)
    (hu : u ∈ m) (hv : v ∈ m) :
    originFactor u v a₁ a₂ a₃ a₄ a₆ ∉ m := by
  have hminus : originFactor u v a₁ a₂ a₃ a₄ a₆ - 1 ∈ m := by
    have hpoly : originFactor u v a₁ a₂ a₃ a₄ a₆ - 1 =
        u * (a₂ + a₄ * u + a₆ * u ^ 2 - a₃ * v) - a₁ * v := by
      dsimp [originFactor]
      ring
    rw [hpoly]
    exact m.sub_mem (m.mul_mem_right _ hu) (m.mul_mem_left _ hv)
  intro hF
  have hone : (1 : R) ∈ m := by
    convert m.sub_mem hF hminus using 1 <;> ring
  exact m.one_notMem hone

/-- The maximal ideal of the origin localization is generated by the image of `v`.

Only primality of `m` is needed here. The application can supply the stronger
fact that `m` is maximal.
-/
theorem maximalIdeal_eq_span_v
    (m : Ideal R) [m.IsPrime] (u v a₁ a₂ a₃ a₄ a₆ : R)
    (hspan : m = Ideal.span ({u, v} : Set R))
    (hrelation : v ^ 2 = u * originFactor u v a₁ a₂ a₃ a₄ a₆) :
    IsLocalRing.maximalIdeal (Localization.AtPrime m) =
      Ideal.span {algebraMap R (Localization.AtPrime m) v} := by
  let S := Localization.AtPrime m
  let f : R →+* S := algebraMap R S
  let J : Ideal S := Ideal.span {f v}
  have hu : u ∈ m := by
    rw [hspan]
    exact Ideal.subset_span (by simp)
  have hv : v ∈ m := by
    rw [hspan]
    exact Ideal.subset_span (by simp)
  have hFunit : IsUnit (f (originFactor u v a₁ a₂ a₃ a₄ a₆)) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff S m _).mpr
      (originFactor_notMem m u v a₁ a₂ a₃ a₄ a₆ hu hv)
  have hvJ : f v ∈ J := Ideal.subset_span (by simp)
  have hEq : (f v) ^ 2 = f u * f (originFactor u v a₁ a₂ a₃ a₄ a₆) := by
    simpa only [map_pow, map_mul] using congrArg f hrelation
  have hprod : f (originFactor u v a₁ a₂ a₃ a₄ a₆) * f u ∈ J := by
    rw [mul_comm, ← hEq, pow_two]
    exact J.mul_mem_left _ hvJ
  have huJ : f u ∈ J := (J.unit_mul_mem_iff_mem hFunit).mp hprod
  have hmap : m.map f = IsLocalRing.maximalIdeal S :=
    Localization.AtPrime.map_eq_maximalIdeal
  change IsLocalRing.maximalIdeal S = J
  rw [← hmap]
  apply le_antisymm
  · apply Ideal.map_le_iff_le_comap.mpr
    apply le_trans (le_of_eq hspan)
    apply Ideal.span_le.mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with hx | hx
    · subst x
      exact huJ
    · have hx' : x = v := Set.mem_singleton_iff.mp hx
      subst x
      exact hvJ
  · apply Ideal.span_le.mpr
    intro x hx
    have hx' : x = f v := Set.mem_singleton_iff.mp hx
    subst x
    exact Ideal.mem_map_of_mem f hv

/-- A Noetherian origin localization is integrally closed, including the field case. -/
theorem isIntegrallyClosed_at_origin [IsDomain R] [IsNoetherianRing R]
    (m : Ideal R) [m.IsPrime] (u v a₁ a₂ a₃ a₄ a₆ : R)
    (hspan : m = Ideal.span ({u, v} : Set R))
    (hrelation : v ^ 2 = u * originFactor u v a₁ a₂ a₃ a₄ a₆) :
    IsIntegrallyClosed (Localization.AtPrime m) := by
  have hprincipal : (IsLocalRing.maximalIdeal (Localization.AtPrime m)).IsPrincipal := by
    rw [maximalIdeal_eq_span_v m u v a₁ a₂ a₃ a₄ a₆ hspan hrelation]
    infer_instance
  -- The principal maximal ideal is entry 4 and integral closedness is entry 3.
  exact (((tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain
    (Localization.AtPrime m)).out 4 3 rfl rfl).mp hprincipal).1


