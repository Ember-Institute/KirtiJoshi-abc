import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
source-id: JT-SCENE1-BOUNDARY-PRODUCER-CONTRACTS-20261021
source: IUT I Definition 3.1(d),(f); Joshi III `ss:theta-data-fixing2`.
fidelity: the origin in the algebra generated by two actual coordinates is
maximal whenever a proper ambient ideal contains both. The quotient consists
of constants. The seed consumer supplies the actual infinity prime.
Original proofs; no reference implementation copied.
boundary: this does not prove that a normalization fiber is a singleton.
-/

namespace JoshiTeich.Act1Scene1.InverseChartRawAlgebra

variable (k : Type*) [CommRing k] {R : Type*} [CommRing R] [Algebra k R]

/-- The algebra generated by the two inverse coordinates. -/
abbrev coordinateAlgebra (u v : R) : Subalgebra k R :=
  Algebra.adjoin k ({u, v} : Set R)

/-- The first generator, regarded as an element of the generated algebra. -/
def firstGenerator (u v : R) : coordinateAlgebra k u v :=
  ⟨u, Algebra.subset_adjoin (by simp)⟩

/-- The second generator, regarded as an element of the generated algebra. -/
def secondGenerator (u v : R) : coordinateAlgebra k u v :=
  ⟨v, Algebra.subset_adjoin (by simp)⟩

/-- The ideal of the inverse-chart origin. -/
def originIdeal (u v : R) : Ideal (coordinateAlgebra k u v) :=
  Ideal.span ({firstGenerator k u v, secondGenerator k u v} :
    Set (coordinateAlgebra k u v))

/-- Setting both generators to zero leaves only constants in the quotient.
No properness assumption or polynomial presentation is needed for this step. -/
theorem quotient_algebraMap_surjective (u v : R) :
    Function.Surjective
      (algebraMap k ((coordinateAlgebra k u v) ⧸ originIdeal k u v)) := by
  let B := coordinateAlgebra k u v
  let I : Ideal B := originIdeal k u v
  let Q := B ⧸ I
  have hu0 : Ideal.Quotient.mk I (firstGenerator k u v) = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.subset_span (by simp)
  have hv0 : Ideal.Quotient.mk I (secondGenerator k u v) = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.subset_span (by simp)
  have hconst : ∀ (x : R) (hx : x ∈ B),
      ∃ c : k, algebraMap k Q c = Ideal.Quotient.mk I (⟨x, hx⟩ : B) := by
    intro x hx
    refine Algebra.adjoin_induction
      (s := ({u, v} : Set R))
      (p := fun x hx =>
        ∃ c : k, algebraMap k Q c = Ideal.Quotient.mk I (⟨x, hx⟩ : B))
      ?_ ?_ ?_ ?_ hx
    · intro x hx
      rcases Set.mem_insert_iff.mp hx with rfl | hx
      · refine ⟨0, ?_⟩
        simpa only [map_zero, firstGenerator] using hu0.symm
      · rcases Set.mem_singleton_iff.mp hx with rfl
        refine ⟨0, ?_⟩
        simpa only [map_zero, secondGenerator] using hv0.symm
    · intro c
      exact ⟨c, rfl⟩
    · intro x y hx hy hxc hyc
      rcases hxc with ⟨cx, hcx⟩
      rcases hyc with ⟨cy, hcy⟩
      refine ⟨cx + cy, ?_⟩
      change algebraMap k Q (cx + cy) =
        Ideal.Quotient.mk I ((⟨x, hx⟩ : B) + (⟨y, hy⟩ : B))
      rw [map_add, map_add, hcx, hcy]
    · intro x y hx hy hxc hyc
      rcases hxc with ⟨cx, hcx⟩
      rcases hyc with ⟨cy, hcy⟩
      refine ⟨cx * cy, ?_⟩
      change algebraMap k Q (cx * cy) =
        Ideal.Quotient.mk I ((⟨x, hx⟩ : B) * (⟨y, hy⟩ : B))
      rw [map_mul, map_mul, hcx, hcy]
  change Function.Surjective (algebraMap k Q)
  intro z
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact hconst x.val x.property

/-- Any ambient ideal containing both generators contains the origin ideal
when pulled back to the coordinate algebra. -/
theorem originIdeal_le_comap (u v : R) (P : Ideal R)
    (hu : u ∈ P) (hv : v ∈ P) :
    originIdeal k u v ≤ P.comap (coordinateAlgebra k u v).val.toRingHom := by
  apply Ideal.span_le.mpr
  intro z hz
  rcases Set.mem_insert_iff.mp hz with rfl | hz
  · exact hu
  · rcases Set.mem_singleton_iff.mp hz with rfl
    exact hv

/-- An existing proper ambient ideal through the origin proves properness
of the origin ideal in the two-generator algebra. -/
theorem originIdeal_ne_top (u v : R) (P : Ideal R)
    (hP : P ≠ ⊤) (hu : u ∈ P) (hv : v ∈ P) :
    originIdeal k u v ≠ ⊤ :=
  ne_top_of_le_ne_top
    (Ideal.comap_ne_top (coordinateAlgebra k u v).val.toRingHom hP)
    (originIdeal_le_comap k u v P hu hv)

end JoshiTeich.Act1Scene1.InverseChartRawAlgebra

namespace JoshiTeich.Act1Scene1.InverseChartRawAlgebra

variable {k R : Type*} [Field k] [CommRing R] [Algebra k R]

/-- If an ambient proper ideal contains both inverse coordinates, their
origin ideal is maximal. The ambient ideal need not itself be prime. -/
theorem originIdeal_isMaximal (u v : R) (P : Ideal R)
    (hP : P ≠ ⊤) (hu : u ∈ P) (hv : v ∈ P) :
    (originIdeal k u v).IsMaximal := by
  let B := coordinateAlgebra k u v
  let I : Ideal B := originIdeal k u v
  let Q := B ⧸ I
  have hI : I ≠ ⊤ := originIdeal_ne_top k u v P hP hu hv
  letI : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hI
  have hsurj : Function.Surjective (algebraMap k Q) :=
    quotient_algebraMap_surjective k u v
  apply Ideal.Quotient.maximal_of_isField
  change IsField Q
  refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, ?_⟩
  intro x hx
  obtain ⟨c, rfl⟩ := hsurj x
  have hc : c ≠ 0 := by
    intro hc
    apply hx
    simp [hc]
  refine ⟨algebraMap k Q c⁻¹, ?_⟩
  rw [← map_mul, mul_inv_cancel₀ hc, map_one]

/-- Prime-ideal convenience form, using only the prime's properness. -/
theorem originIdeal_isMaximal_of_prime (u v : R) (P : Ideal R)
    (hP : P.IsPrime) (hu : u ∈ P) (hv : v ∈ P) :
    (originIdeal k u v).IsMaximal :=
  originIdeal_isMaximal u v P hP.ne_top hu hv

end JoshiTeich.Act1Scene1.InverseChartRawAlgebra
