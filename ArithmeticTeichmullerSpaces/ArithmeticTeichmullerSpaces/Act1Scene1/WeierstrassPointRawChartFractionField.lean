import ArithmeticTeichmullerSpaces.Act1Scene1.WeierstrassPointRawChartNormality
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
source-id: JT-SCENE1-BOUNDARY-PRODUCER-CONTRACTS-20261021
additional-source-ids: JT-SCENE1-GENUINE-DIVISION-POINT-EVALUATION
source: the same coordinate evaluation and its extension to the original
Weierstrass function field; Mathlib's fraction-field image theorem.
fidelity: the raw algebra of the supplied actual point has as fraction field
the image of its SAME function-field evaluation, with the original ambient
values preserved by the canonical inclusion. The ambient field K itself is
not asserted to be the raw chart's fraction field.
boundary: does not identify this image with any larger normalization field,
or prove an upper residue-field identity.
-/

namespace JoshiTeich.Act1Scene1.WeierstrassPointRawChartFractionField

open WeierstrassCurve
open JoshiTeich.ReferenceIut.Anabelian
open WeierstrassTranscendentalPointEvaluation WeierstrassPointRawChartNormality
open scoped Classical
noncomputable section
universe u v

variable {k : Type u} [Field k] (E : WeierstrassCurve k) [E.IsElliptic]
  {K : Type v} [Field K] [Algebra k K]
  (P : (E⁄K).toAffine.Point) (hP : P ≠ 0) (hx : Transcendental k (ptX P))

/-- The same function-field evaluation has exactly the field generated by the actual coordinates. -/
theorem fieldRange_eq_adjoin :
    (functionFieldAlgHom E P hP hx).fieldRange =
      IntermediateField.adjoin k ({ptX P, ptY P} : Set K) := by
  exact IsFractionRing.liftAlgHom_fieldRange_eq_of_range_eq
    (K := E.toAffine.FunctionField)
    (coordinateAlgHom_injective E P hP hx)
    (coordinateAlgHom_range_eq_rawChart E P hP)

/-- The raw chart lies in this image by the original ambient inclusion. -/
theorem rawChart_le_fieldRange :
    rawChart E P ≤ (functionFieldAlgHom E P hP hx).fieldRange.toSubalgebra := by
  rw [fieldRange_eq_adjoin]
  exact IntermediateField.algebra_adjoin_le_adjoin k ({ptX P, ptY P} : Set K)

/-- Include the same original two-coordinate chart into the image field. -/
def rawChartToFieldRange :
    rawChart E P →ₐ[k] (functionFieldAlgHom E P hP hx).fieldRange :=
  Subalgebra.inclusion (rawChart_le_fieldRange E P hP hx)

@[simp] theorem coe_rawChartToFieldRange (a : rawChart E P) :
    (rawChartToFieldRange E P hP hx a : K) = (a : K) := rfl

/-- Use this ambient inclusion, rather than a transported arbitrary field isomorphism. -/
@[instance_reducible] def rawChartFieldRangeAlgebra :
    Algebra (rawChart E P) (functionFieldAlgHom E P hP hx).fieldRange :=
  (rawChartToFieldRange E P hP hx).toRingHom.toAlgebra

attribute [local instance] rawChartFieldRangeAlgebra

@[simp] theorem coe_algebraMap (a : rawChart E P) :
    (algebraMap (rawChart E P) (functionFieldAlgHom E P hP hx).fieldRange a : K) =
      (a : K) := rfl

/-- The same coefficient map commutes with the raw-chart inclusion. -/
theorem coefficientTower :
    IsScalarTower k (rawChart E P) (functionFieldAlgHom E P hP hx).fieldRange :=
  IsScalarTower.of_algebraMap_eq
    (R := k) (S := rawChart E P)
    (A := (functionFieldAlgHom E P hP hx).fieldRange) (fun _ => rfl)

/-- Both inclusions retain their original value in the same ambient field. -/
theorem ambientTower :
    IsScalarTower (rawChart E P) (functionFieldAlgHom E P hP hx).fieldRange K :=
  IsScalarTower.of_algebraMap_eq
    (R := rawChart E P) (S := (functionFieldAlgHom E P hP hx).fieldRange)
    (A := K) (fun _ => rfl)

/-- The inclusion is faithful because its ambient value is the original subtype value. -/
private theorem faithfulSMul :
    FaithfulSMul (rawChart E P) (functionFieldAlgHom E P hP hx).fieldRange := by
  rw [faithfulSMul_iff_algebraMap_injective]
  intro a b hab
  exact Subtype.ext (congrArg (fun z : (functionFieldAlgHom E P hP hx).fieldRange =>
    (z : K)) hab)

/-- The image field, not all of K, is the common fraction field of the actual raw chart. -/
theorem isFractionRing_fieldRange :
    IsFractionRing (rawChart E P) (functionFieldAlgHom E P hP hx).fieldRange := by
  letI := faithfulSMul E P hP hx
  apply IsFractionRing.of_field
  intro z
  obtain ⟨t, ht⟩ := z.property
  obtain ⟨a, b, _, hab⟩ := IsFractionRing.div_surjective E.toAffine.CoordinateRing t
  refine ⟨coordinateRawChartEquiv E P hP hx a,
    coordinateRawChartEquiv E P hP hx b, ?_⟩
  apply Subtype.ext
  change (z : K) = coordinateAlgHom E P hP a / coordinateAlgHom E P hP b
  simpa only [map_div₀, functionFieldAlgHom_algebraMap] using
    ((congrArg (functionFieldAlgHom E P hP hx) hab).trans ht).symm

end
end JoshiTeich.Act1Scene1.WeierstrassPointRawChartFractionField
