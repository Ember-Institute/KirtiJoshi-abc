import ArithmeticTeichmullerSpaces.Act1Scene1.IutGeometricTorsionBasis
import Mathlib.GroupTheory.Index

/-!
source-id: IUT-COR312-FOUR-TORSION-SOURCE
fidelity: proves halving of geometric two-torsion and constructs two distinct
nonzero two-torsion points with halves. Their coordinates lie in the finite
extension generated by all geometric four-torsion coordinates. This extension
has rational point pairs for the cyclic ratio argument. No claim is made that
the halves are rational over the original base field. Local estimates, height
transport and absence of a cyclic subgroup remain separate obligations.
boundary: Scene1/Derived
-/

namespace JoshiTeich.Act1Scene1

open WeierstrassCurve
open scoped Classical

universe u
noncomputable section

/-- Two distinct nonzero two-torsion points and one half of each point. -/
structure IutFourTorsionPointPairs {k : Type u} [Field k] (W : WeierstrassCurve k) where
  T₁ : W.toAffine.Point
  R₁ : W.toAffine.Point
  T₂ : W.toAffine.Point
  R₂ : W.toAffine.Point
  T₁_ne_zero : T₁ ≠ 0
  T₂_ne_zero : T₂ ≠ 0
  T₁_ne_T₂ : T₁ ≠ T₂
  T₁_add_self : T₁ + T₁ = 0
  T₂_add_self : T₂ + T₂ = 0
  R₁_add_self : R₁ + R₁ = T₁
  R₂_add_self : R₂ + R₂ = T₂

section Geometric

variable {k : Type u} [Field k] [CharZero k] [IsAlgClosed k]
variable (W : WeierstrassCurve k) [W.IsElliptic]

/-- Every geometric two-torsion point has a half in the geometric four-torsion. -/
theorem iutGeometricTwoTorsion_hasHalf (T : W.toAffine.Point)
    (hT : 2 • T = 0) : ∃ R : W.toAffine.Point, 2 • R = T := by
  let A₂ := AddSubgroup.torsionBy W.toAffine.Point 2
  let A₄ := AddSubgroup.torsionBy W.toAffine.Point 4
  have hc₂ : Nat.card A₂ = 4 := by simpa [A₂] using iutGeometricTorsion_card W 2 (by decide)
  have hc₄ : Nat.card A₄ = 16 := by simpa [A₄] using iutGeometricTorsion_card W 4 (by decide)
  letI : Finite A₂ := Nat.finite_of_card_ne_zero (by rw [hc₂]; decide)
  letI : Finite A₄ := Nat.finite_of_card_ne_zero (by rw [hc₄]; decide)
  let f : A₄ →+ A₂ :=
    { toFun := fun P => ⟨2 • P.1, AddSubgroup.torsionBy.nsmul_iff.mpr (by
        have h := AddSubgroup.torsionBy.nsmul_iff.mp P.2
        simpa only [← mul_nsmul, show (2 : ℕ) * 2 = 4 by decide] using h)⟩
      map_zero' := Subtype.ext (nsmul_zero 2)
      map_add' := fun P Q => Subtype.ext (nsmul_add P.1 Q.1 2) }
  let j : f.ker → A₂ := fun P => ⟨P.1.1, AddSubgroup.torsionBy.nsmul_iff.mpr (by
    have h := congrArg Subtype.val (AddMonoidHom.mem_ker.mp P.2)
    exact h)⟩
  have hj : Function.Injective j := by
    intro P Q h
    apply Subtype.ext
    apply Subtype.ext
    change P.1.1 = Q.1.1
    exact congrArg (fun z : A₂ => z.1) h
  have hker : Nat.card f.ker ≤ 4 := (Nat.card_le_card_of_injective j hj).trans_eq hc₂
  have hsurj : Function.Surjective f := by
    apply AddMonoidHom.surjective_of_card_ker_le_div f
    simpa only [hc₄, hc₂, show (16 : ℕ) / 4 = 4 by decide] using hker
  obtain ⟨R, hR⟩ := hsurj ⟨T, AddSubgroup.torsionBy.nsmul_iff.mpr hT⟩
  exact ⟨R.1, congrArg Subtype.val hR⟩

/-- Construct the point pairs from geometric torsion, without external choices of halves. -/
theorem iutGeometricFourTorsionPointPairs_exists : Nonempty (IutFourTorsionPointPairs W) := by
  letI : Fact (Nat.Prime 2) := ⟨by decide⟩
  obtain ⟨e⟩ := iutGeometricTorsionBasis W 2
  let P₁ := e.symm (![1, 0] : Fin 2 → ZMod 2)
  let P₂ := e.symm (![0, 1] : Fin 2 → ZMod 2)
  have hP₁ : P₁.1 ≠ 0 := by
    intro h
    have h' : P₁ = 0 := Subtype.ext h
    have := congrArg (fun P => e P 0) h'
    norm_num [P₁] at this
  have hP₂ : P₂.1 ≠ 0 := by
    intro h
    have h' : P₂ = 0 := Subtype.ext h
    have := congrArg (fun P => e P 1) h'
    norm_num [P₂] at this
  have hP₁₂ : P₁.1 ≠ P₂.1 := by
    intro h
    have h' : P₁ = P₂ := Subtype.ext h
    have := congrArg (fun P => e P 0) h'
    norm_num [P₁, P₂] at this
  have hT₁ := AddSubgroup.torsionBy.nsmul_iff.mp P₁.2
  have hT₂ := AddSubgroup.torsionBy.nsmul_iff.mp P₂.2
  obtain ⟨R₁, hR₁⟩ := iutGeometricTwoTorsion_hasHalf W P₁.1 hT₁
  obtain ⟨R₂, hR₂⟩ := iutGeometricTwoTorsion_hasHalf W P₂.1 hT₂
  exact ⟨⟨P₁.1, R₁, P₂.1, R₂, hP₁, hP₂, hP₁₂,
    by simpa only [two_nsmul] using hT₁,
    by simpa only [two_nsmul] using hT₂,
    by simpa only [two_nsmul] using hR₁,
    by simpa only [two_nsmul] using hR₂⟩⟩

/-- Choose the point pairs supplied by the geometric existence theorem. -/
def iutGeometricFourTorsionPointPairs : IutFourTorsionPointPairs W :=
  Classical.choice (iutGeometricFourTorsionPointPairs_exists W)

end Geometric

namespace IutFourTorsionPointPairs

variable {k : Type u} [Field k] {W : WeierstrassCurve k}
variable (P : IutFourTorsionPointPairs W)

lemma four_nsmul_T₁ : 4 • P.T₁ = 0 := by
  rw [show (4 : ℕ) = 2 * 2 from rfl, mul_nsmul, two_nsmul P.T₁, P.T₁_add_self, nsmul_zero]
lemma four_nsmul_T₂ : 4 • P.T₂ = 0 := by
  rw [show (4 : ℕ) = 2 * 2 from rfl, mul_nsmul, two_nsmul P.T₂, P.T₂_add_self, nsmul_zero]
lemma four_nsmul_R₁ : 4 • P.R₁ = 0 := by
  rw [show (4 : ℕ) = 2 * 2 from rfl, mul_nsmul, two_nsmul P.R₁, P.R₁_add_self,
    two_nsmul, P.T₁_add_self]
lemma four_nsmul_R₂ : 4 • P.R₂ = 0 := by
  rw [show (4 : ℕ) = 2 * 2 from rfl, mul_nsmul, two_nsmul P.R₂, P.R₂_add_self,
    two_nsmul, P.T₂_add_self]

end IutFourTorsionPointPairs

namespace IutFourTorsion

variable {F : Type u} [Field F] [NumberField F]
variable (E : WeierstrassCurve F) [E.IsElliptic]
variable (Fbar : Type u) [Field Fbar] [Algebra F Fbar] [IsAlgClosure F Fbar]

/-- The affine coordinates of a point, with an empty set at the origin. -/
def coords : Affine.Point (Affine.baseChange E Fbar) → Set Fbar
  | .zero => ∅
  | .some x y _ => {x, y}

/-- All geometric four-torsion coordinates of the actual curve. -/
def coordinates : Set Fbar :=
  ⋃ P ∈ (AddSubgroup.torsionBy (Affine.Point (Affine.baseChange E Fbar)) 4 :
    Set (Affine.Point (Affine.baseChange E Fbar))), coords E Fbar P

/-- The field generated by the geometric four-torsion coordinates. -/
def field : IntermediateField F Fbar := IntermediateField.adjoin F (coordinates E Fbar)

lemma coordinates_finite : (coordinates E Fbar).Finite := by
  letI : CharZero Fbar := charZero_of_injective_algebraMap (algebraMap F Fbar).injective
  letI : IsAlgClosed Fbar := IsAlgClosure.isAlgClosed F
  letI : (E.map (algebraMap F Fbar)).IsElliptic := inferInstance
  have hc : Nat.card (AddSubgroup.torsionBy
      (Affine.Point (Affine.baseChange E Fbar)) (4 : ℤ)) = 16 := by
    change Nat.card (AddSubgroup.torsionBy
      (E.map (algebraMap F Fbar)).toAffine.Point (4 : ℤ)) = 16
    simpa using iutGeometricTorsion_card (E.map (algebraMap F Fbar)) 4 (by decide)
  letI : Finite (AddSubgroup.torsionBy (Affine.Point (Affine.baseChange E Fbar)) 4) :=
    Nat.finite_of_card_ne_zero (by rw [hc]; decide)
  unfold coordinates
  exact (Set.toFinite (↑(AddSubgroup.torsionBy
    (Affine.Point (Affine.baseChange E Fbar)) 4) :
      Set (Affine.Point (Affine.baseChange E Fbar)))).biUnion fun P _ => by
      cases P with
      | zero => exact Set.finite_empty
      | some x y _ => exact (Set.finite_singleton y).insert x

lemma finiteDimensional_field : FiniteDimensional F ↥(field E Fbar) := by
  letI : Finite (coordinates E Fbar) := (coordinates_finite E Fbar).to_subtype
  exact IntermediateField.finiteDimensional_adjoin
    fun x _ => Algebra.IsIntegral.isIntegral x

instance numberField_field : NumberField ↥(field E Fbar) := by
  letI : FiniteDimensional F ↥(field E Fbar) := finiteDimensional_field E Fbar
  letI : CharZero ↥(field E Fbar) :=
    charZero_of_injective_algebraMap (algebraMap F ↥(field E Fbar)).injective
  letI : IsScalarTower ℚ F ↥(field E Fbar) :=
    IsScalarTower.of_algebraMap_eq' (Subsingleton.elim _ _)
  letI : FiniteDimensional ℚ ↥(field E Fbar) := Module.Finite.trans F ↥(field E Fbar)
  exact {}

/-- Every geometric four-torsion point is rational over the coordinate field. -/
lemma exists_point_over_field (P : Affine.Point (Affine.baseChange E Fbar))
    (hP : 4 • P = 0) :
    ∃ Q : Affine.Point (Affine.baseChange E ↥(field E Fbar)),
      Affine.Point.map (W' := E) (S := F)
        (IsScalarTower.toAlgHom F ↥(field E Fbar) Fbar) Q = P := by
  cases P with
  | zero => exact ⟨0, rfl⟩
  | some x y h =>
    have hx : x ∈ field E Fbar := IntermediateField.subset_adjoin F _
      (Set.mem_biUnion (x := Affine.Point.some x y h)
        (AddSubgroup.torsionBy.nsmul_iff.mpr hP) (by simp [coords]))
    have hy : y ∈ field E Fbar := IntermediateField.subset_adjoin F _
      (Set.mem_biUnion (x := Affine.Point.some x y h)
        (AddSubgroup.torsionBy.nsmul_iff.mpr hP) (by simp [coords]))
    have hns : (Affine.baseChange E ↥(field E Fbar)).Nonsingular
        (⟨x, hx⟩ : ↥(field E Fbar)) ⟨y, hy⟩ :=
      (Affine.baseChange_nonsingular (W := E)
        (IsScalarTower.toAlgHom F ↥(field E Fbar) Fbar).injective _ _).mp h
    exact ⟨Affine.Point.some _ _ hns, rfl⟩

/-- The actual auxiliary point pairs exist over the finite four-torsion coordinate field. -/
theorem pointPairs_over_field : Nonempty (IutFourTorsionPointPairs
    (E.map (algebraMap F ↥(field E Fbar)))) := by
  letI : CharZero Fbar := charZero_of_injective_algebraMap (algebraMap F Fbar).injective
  letI : IsAlgClosed Fbar := IsAlgClosure.isAlgClosed F
  letI : DecidableEq ↥(field E Fbar) := Classical.decEq _
  let P := iutGeometricFourTorsionPointPairs (E.map (algebraMap F Fbar))
  let b : (E.map (algebraMap F ↥(field E Fbar))).toAffine.Point →+
      (E.map (algebraMap F Fbar)).toAffine.Point :=
    Affine.Point.map (W' := E) (S := F)
      (IsScalarTower.toAlgHom F ↥(field E Fbar) Fbar)
  have hb : Function.Injective b := Affine.Point.map_injective
    (IsScalarTower.toAlgHom F ↥(field E Fbar) Fbar)
  obtain ⟨T₁, hT₁⟩ := exists_point_over_field E Fbar P.T₁ P.four_nsmul_T₁
  obtain ⟨T₂, hT₂⟩ := exists_point_over_field E Fbar P.T₂ P.four_nsmul_T₂
  obtain ⟨R₁, hR₁⟩ := exists_point_over_field E Fbar P.R₁ P.four_nsmul_R₁
  obtain ⟨R₂, hR₂⟩ := exists_point_over_field E Fbar P.R₂ P.four_nsmul_R₂
  change (E.map (algebraMap F ↥(field E Fbar))).toAffine.Point at T₁ T₂ R₁ R₂
  change b T₁ = P.T₁ at hT₁
  change b T₂ = P.T₂ at hT₂
  change b R₁ = P.R₁ at hR₁
  change b R₂ = P.R₂ at hR₂
  refine ⟨⟨T₁, R₁, T₂, R₂, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩⟩
  · intro h
    apply P.T₁_ne_zero
    rw [← hT₁, h, map_zero]
  · intro h
    apply P.T₂_ne_zero
    rw [← hT₂, h, map_zero]
  · intro h
    apply P.T₁_ne_T₂
    rw [← hT₁, ← hT₂, h]
  · apply hb
    rw [map_add, map_zero, hT₁, P.T₁_add_self]
  · apply hb
    rw [map_add, map_zero, hT₂, P.T₂_add_self]
  · apply hb
    rw [map_add, hR₁, hT₁, P.R₁_add_self]
  · apply hb
    rw [map_add, hR₂, hT₂, P.R₂_add_self]

end IutFourTorsion

end
end JoshiTeich.Act1Scene1
