  poleShiftClosureRing_coefficientAlgebra

variable {AG : AnabelianGeometry.{u}} {TG : TemperedGeometry AG}
variable (S : InitialThetaGeometrySeed AG TG)

/-- The affine coordinate algebra of the ORIGINAL shifted point in the ORIGINAL closure. -/
def infinityDivisionClosureShiftedAffineChart :
    Subalgebra ↥S.prime.torsionField S.infinityDivisionNormalClosure :=
  Algebra.adjoin ↥S.prime.torsionField
    {ptX S.infinityDivisionClosureShiftedQpt, ptY S.infinityDivisionClosureShiftedQpt}

local instance shiftedAffineChart_commRing :
    CommRing S.infinityDivisionClosureShiftedAffineChart :=
  S.infinityDivisionClosureShiftedAffineChart.toCommRing

local instance shiftedAffineChart_isDomain :
    IsDomain S.infinityDivisionClosureShiftedAffineChart := Subalgebra.isDomain _

local instance shiftedAffineChart_coefficientAlgebra :
    Algebra ↥S.prime.torsionField S.infinityDivisionClosureShiftedAffineChart :=
  S.infinityDivisionClosureShiftedAffineChart.algebra'

local instance shiftedAffineChart_coefficientSMul :
    SMul ↥S.prime.torsionField S.infinityDivisionClosureShiftedAffineChart :=
  S.shiftedAffineChart_coefficientAlgebra.toSMul

local instance shiftedAffineChart_coefficientModule :
    Module ↥S.prime.torsionField S.infinityDivisionClosureShiftedAffineChart :=
  S.shiftedAffineChart_coefficientAlgebra.toModule

/-- The ORIGINAL shifted coordinate algebra is integrally closed. -/
theorem infinityDivisionClosureShiftedAffineChart_isIntegrallyClosed :
    IsIntegrallyClosed S.infinityDivisionClosureShiftedAffineChart :=
  WeierstrassPointRawChartNormality.rawChart_isIntegrallyClosed S.prime.EK
    S.infinityDivisionClosureShiftedQpt S.infinityDivisionClosureShiftedQpt_ne_zero
    S.infinityDivisionClosureShiftedQpt_x_transcendental

variable (p : HeightOneSpectrum
  (coordRing (Genuine.xG S.prime.EK)⁻¹ S.infinityDivisionNormalClosure))

local instance shiftedAffineChart_primeCommRing :
    CommRing (S.infinityDivisionClosurePrimeValuation p) :=
  (S.infinityDivisionClosurePrimeValuation p).toSubring.toCommRing

local instance shiftedAffineChart_primeLocalRing :
    IsLocalRing (S.infinityDivisionClosurePrimeValuation p) :=
  ValuationSubring.isLocalRing _

local instance shiftedAffineChart_residueField :
    Field (S.infinityDivisionClosurePrimeResidueField p) :=
  IsLocalRing.ResidueField.field (S.infinityDivisionClosurePrimeValuation p)

local instance shiftedAffineChart_valuation_coefficientAlgebra :
    Algebra ↥S.prime.torsionField (S.infinityDivisionClosurePrimeValuation p) :=
  ValuationResidueCoefficients.ringCoefficientAlgebra
    (S.infinityDivisionClosurePrimeValuation p)
    (S.infinityDivisionClosurePrimeValuation_coefficients_mem p)

attribute [local instance] infinityDivisionClosurePrimeResidue_coefficientAlgebra

local instance shiftedAffineChart_residue_coefficientSMul :
    SMul ↥S.prime.torsionField (S.infinityDivisionClosurePrimeResidueField p) :=
  (S.infinityDivisionClosurePrimeResidue_coefficientAlgebra p).toSMul

local instance shiftedAffineChart_residue_coefficientModule :
    Module ↥S.prime.torsionField (S.infinityDivisionClosurePrimeResidueField p) :=
  (S.infinityDivisionClosurePrimeResidue_coefficientAlgebra p).toModule

variable (hp : algebraMap
  (polynomialBase ↥S.prime.torsionField (Genuine.xG S.prime.EK)⁻¹)
  (coordRing (Genuine.xG S.prime.EK)⁻¹ S.infinityDivisionNormalClosure)
  (polynomialCoordinate (Genuine.xG S.prime.EK)⁻¹) ∈ p.asIdeal)

include hp in
/-- Every original chart element lies in the SAME original finite-prime valuation ring. -/
theorem infinityDivisionClosureShiftedAffineChart_mem_valuation :
    ∀ z ∈ S.infinityDivisionClosureShiftedAffineChart,
      z ∈ S.infinityDivisionClosurePrimeValuation p := by
  exact ConstantResidueGeneratedAlgebra.adjoin_pair_mem_valuation
    (S.infinityDivisionClosurePrimeValuation p)
    (S.infinityDivisionClosurePrimeValuation_coefficients_mem p)
    (ptX S.infinityDivisionClosureShiftedQpt) (ptY S.infinityDivisionClosureShiftedQpt)
    (S.infinityDivisionClosurePrime_shifted_Qpt_coordinates_mem p hp).1
    (S.infinityDivisionClosurePrime_shifted_Qpt_coordinates_mem p hp).2

/-- Restrict this original chart to the original valuation ring. -/
def infinityDivisionClosureShiftedAffineChart_valuationMap :
    S.infinityDivisionClosureShiftedAffineChart →ₐ[↥S.prime.torsionField]
      S.infinityDivisionClosurePrimeValuation p :=
  ConstantResidueGeneratedAlgebra.valuationMap
    (S.infinityDivisionClosurePrimeValuation p)
    (S.infinityDivisionClosurePrimeValuation_coefficients_mem p)
    (ptX S.infinityDivisionClosureShiftedQpt) (ptY S.infinityDivisionClosureShiftedQpt)
    (S.infinityDivisionClosurePrime_shifted_Qpt_coordinates_mem p hp).1
    (S.infinityDivisionClosurePrime_shifted_Qpt_coordinates_mem p hp).2

/-- Take the canonical residue of each element of the SAME original chart. -/
def infinityDivisionClosureShiftedAffineChart_residueMap :
    S.infinityDivisionClosureShiftedAffineChart →ₐ[↥S.prime.torsionField]
      S.infinityDivisionClosurePrimeResidueField p :=
  ConstantResidueGeneratedAlgebra.residueMap
    (S.infinityDivisionClosurePrimeValuation p)
    (S.infinityDivisionClosurePrimeValuation_coefficients_mem p)
    (ptX S.infinityDivisionClosureShiftedQpt) (ptY S.infinityDivisionClosureShiftedQpt)
    (S.infinityDivisionClosurePrime_shifted_Qpt_coordinates_mem p hp).1
    (S.infinityDivisionClosurePrime_shifted_Qpt_coordinates_mem p hp).2

/-- The residue of every element of this ORIGINAL chart is an original constant. -/
theorem infinityDivisionClosureShiftedAffineChart_residue_constants
    (z : S.infinityDivisionClosureShiftedAffineChart) :
    ∃ c : ↥S.prime.torsionField,
      algebraMap ↥S.prime.torsionField (S.infinityDivisionClosurePrimeResidueField p) c =
        S.infinityDivisionClosureShiftedAffineChart_residueMap p hp z := by
  exact ConstantResidueGeneratedAlgebra.residueMap_constants_of_pair
    (S.infinityDivisionClosurePrimeValuation p)
    (S.infinityDivisionClosurePrimeValuation_coefficients_mem p)
    (ptX S.infinityDivisionClosureShiftedQpt) (ptY S.infinityDivisionClosureShiftedQpt)
    (S.infinityDivisionClosurePrime_shifted_Qpt_coordinates_mem p hp).1
    (S.infinityDivisionClosurePrime_shifted_Qpt_coordinates_mem p hp).2
    (S.infinityDivisionClosurePrime_shifted_Qpt_residue_coordinates_rational p hp) z

/-- The center induced by the original valuation on this original shifted chart. -/
@[irreducible]
def infinityDivisionClosureShiftedAffineChart_residueKernel :
    Ideal S.infinityDivisionClosureShiftedAffineChart :=
  RingHom.ker (S.infinityDivisionClosureShiftedAffineChart_residueMap p hp).toRingHom

/-- Constants surject onto this chart's quotient by its original residue kernel.
The generic proposition unfolds to the original quotient coefficient map. -/
theorem infinityDivisionClosureShiftedAffineChart_quotient_algebraMap_surjective :
    ConstantResidueGeneratedAlgebra.quotientConstants
      (S.infinityDivisionClosureShiftedAffineChart_residueMap p hp) :=
  ConstantResidueGeneratedAlgebra.quotientConstants_of
    (S.infinityDivisionClosureShiftedAffineChart_residueMap p hp)
    (S.infinityDivisionClosureShiftedAffineChart_residue_constants p hp)

/-- The center of the original valuation on this chart is a maximal ideal. -/
theorem infinityDivisionClosureShiftedAffineChart_residueKernel_isMaximal :
    (S.infinityDivisionClosureShiftedAffineChart_residueKernel p hp).IsMaximal := by
  unfold infinityDivisionClosureShiftedAffineChart_residueKernel
  exact ConstantResidueGeneratedAlgebra.kernel_isMaximal
    (S.infinityDivisionClosureShiftedAffineChart_residueMap p hp)
    (S.infinityDivisionClosureShiftedAffineChart_residue_constants p hp)


/-- The SAME original chart is integrally closed at its actual valuation center.
The generic proposition unfolds to Localization.AtPrime of the original kernel. -/
theorem infinityDivisionClosureShiftedAffineChart_center_isIntegrallyClosed :
    ConstantResidueGeneratedAlgebra.normalAt
      (S.infinityDivisionClosureShiftedAffineChart_residueKernel p hp)
      (S.infinityDivisionClosureShiftedAffineChart_residueKernel_isMaximal p hp).isPrime :=
  ConstantResidueGeneratedAlgebra.normalAt_of
    (S.infinityDivisionClosureShiftedAffineChart_residueKernel p hp)
    S.infinityDivisionClosureShiftedAffineChart_isIntegrallyClosed
    (S.infinityDivisionClosureShiftedAffineChart_residueKernel_isMaximal p hp).isPrime

end
