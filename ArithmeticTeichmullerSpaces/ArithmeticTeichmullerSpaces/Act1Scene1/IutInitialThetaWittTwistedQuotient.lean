namespace JoshiTeich.Act1Scene1.InitialThetaWittTwistedQuotient

open JoshiTeich.Prologue InitialThetaWittAllRadiusCompletion
open InitialThetaWittRationalTatePeriod InitialThetaWittTwistedTatePeriod
open InitialThetaWittEigenKernelTwistedComparison
open scoped Topology
noncomputable section
universe u
variable {AG : JoshiTeich.ReferenceIut.AnabelianGeometry.{u}}
variable {TG : JoshiTeich.ReferenceIut.TemperedGeometry AG}
variable (D : JoshiTeich.ReferenceIut.InitialThetaData AG TG)
variable (w : (iutInitialThetaTateParameterData D).places)

local instance selectedPrime : Fact (Arithmetic.residueChar w.1).Prime :=
  ⟨Arithmetic.residueChar_prime w.1⟩

abbrev Scalars := Padic (Arithmetic.residueChar w.1)
abbrev Full := fullKernel D w
abbrev Twisted := twistedSubmodule D w

/-- The actual Tate period line inside the full eigen theta kernel. -/
def fullPeriodLine : Submodule (Scalars D w) (Full D w) :=
  (kernelPeriodMap D w).toLinearMap.range

/-- The constructed line generated by the divided Tate period. -/
def twistedPeriodLine : Submodule (Scalars D w) (Twisted D w) :=
  (twistedPeriodMap D w).toLinearMap.range

def inverseProductLinear : Full D w →ₗ[Scalars D w] Twisted D w :=
  (productContinuousLinearEquiv D w).symm.toLinearMap

def productLinear : Twisted D w →ₗ[Scalars D w] Full D w :=
  (productContinuousLinearEquiv D w).toLinearMap

theorem inverseProduct_kernelLine :
    fullPeriodLine D w ≤ (twistedPeriodLine D w).comap (inverseProductLinear D w) := by
  rintro x ⟨v, rfl⟩
  change inverseProductLinear D w (kernelPeriodMap D w v) ∈ twistedPeriodLine D w
  have hv : inverseProductLinear D w (kernelPeriodMap D w v) =
      twistedPeriodMap D w v := by
    rfl
  rw [hv]
  exact ⟨v, rfl⟩

theorem inverseProduct_kernel :
    fullPeriodLine D w ≤ ((twistedPeriodLine D w).mkQ.comp
      (inverseProductLinear D w)).ker := by
  intro x hx
  change (twistedPeriodLine D w).mkQ (inverseProductLinear D w x) = 0
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  exact (inverseProduct_kernelLine D w) hx

def quotientInverseProductMap :
    (Full D w ⧸ fullPeriodLine D w) →ₗ[Scalars D w]
      (Twisted D w ⧸ twistedPeriodLine D w) :=
  (fullPeriodLine D w).liftQ
    ((twistedPeriodLine D w).mkQ.comp (inverseProductLinear D w))
    (inverseProduct_kernel D w)

theorem quotientInverseProductMap_mkQ (x : Full D w) :
    quotientInverseProductMap D w ((fullPeriodLine D w).mkQ x) =
      (twistedPeriodLine D w).mkQ (inverseProductLinear D w x) := by
  change ((fullPeriodLine D w).liftQ
    ((twistedPeriodLine D w).mkQ.comp (inverseProductLinear D w)) _)
      ((fullPeriodLine D w).mkQ x) = _
  simpa only [LinearMap.coe_comp, Function.comp_apply] using
    DFunLike.congr_fun
      (Submodule.liftQ_mkQ (fullPeriodLine D w)
        ((twistedPeriodLine D w).mkQ.comp (inverseProductLinear D w))
        (inverseProduct_kernel D w)) x

theorem product_kernelLine :
    twistedPeriodLine D w ≤ (fullPeriodLine D w).comap (productLinear D w) := by
  rintro y ⟨v, rfl⟩
  change productLinear D w (twistedPeriodMap D w v) ∈ fullPeriodLine D w
  have hv : productLinear D w (twistedPeriodMap D w v) =
      kernelPeriodMap D w v := by
    change (productContinuousLinearEquiv D w)
      ((productContinuousLinearEquiv D w).symm (kernelPeriodMap D w v)) =
        kernelPeriodMap D w v
    exact (productContinuousLinearEquiv D w).apply_symm_apply _
  rw [hv]
  exact ⟨v, rfl⟩

theorem product_kernel :
    twistedPeriodLine D w ≤ ((fullPeriodLine D w).mkQ.comp
      (productLinear D w)).ker := by
  intro y hy
  change (fullPeriodLine D w).mkQ (productLinear D w y) = 0
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  exact (product_kernelLine D w) hy

def quotientProductMap :
    (Twisted D w ⧸ twistedPeriodLine D w) →ₗ[Scalars D w]
      (Full D w ⧸ fullPeriodLine D w) :=
  (twistedPeriodLine D w).liftQ
    ((fullPeriodLine D w).mkQ.comp (productLinear D w))
    (product_kernel D w)

theorem quotientProductMap_mkQ (y : Twisted D w) :
    quotientProductMap D w ((twistedPeriodLine D w).mkQ y) =
      (fullPeriodLine D w).mkQ (productLinear D w y) := by
  change ((twistedPeriodLine D w).liftQ
    ((fullPeriodLine D w).mkQ.comp (productLinear D w)) _)
      ((twistedPeriodLine D w).mkQ y) = _
  simpa only [LinearMap.coe_comp, Function.comp_apply] using
    DFunLike.congr_fun
      (Submodule.liftQ_mkQ (twistedPeriodLine D w)
        ((fullPeriodLine D w).mkQ.comp (productLinear D w))
        (product_kernel D w)) y

def quotientLinearEquiv :
    (Full D w ⧸ fullPeriodLine D w) ≃ₗ[Scalars D w]
      (Twisted D w ⧸ twistedPeriodLine D w) :=
  { toFun := quotientInverseProductMap D w
    invFun := quotientProductMap D w
    map_add' := map_add (quotientInverseProductMap D w)
    map_smul' := map_smul (quotientInverseProductMap D w)
    left_inv := by
      intro x
      obtain ⟨x, rfl⟩ := (fullPeriodLine D w).mkQ_surjective x
      rw [quotientInverseProductMap_mkQ, quotientProductMap_mkQ]
      congr 1
      exact (productContinuousLinearEquiv D w).apply_symm_apply x
    right_inv := by
      intro y
      obtain ⟨y, rfl⟩ := (twistedPeriodLine D w).mkQ_surjective y
      rw [quotientProductMap_mkQ, quotientInverseProductMap_mkQ]
      congr 1
      exact (productContinuousLinearEquiv D w).symm_apply_apply y }

theorem quotientLinearEquiv_mkQ (x : Full D w) :
    quotientLinearEquiv D w ((fullPeriodLine D w).mkQ x) =
      (twistedPeriodLine D w).mkQ (inverseProductLinear D w x) :=
  quotientInverseProductMap_mkQ D w x

theorem quotientLinearEquiv_symm_mkQ (y : Twisted D w) :
    (quotientLinearEquiv D w).symm ((twistedPeriodLine D w).mkQ y) =
      (fullPeriodLine D w).mkQ (productLinear D w y) :=
  quotientProductMap_mkQ D w y

theorem quotient_subsingleton_iff_fullPeriodLine_eq_top :
    (Subsingleton (Full D w ⧸ fullPeriodLine D w)) ↔ fullPeriodLine D w = ⊤ := by
  constructor
  · intro h
    apply top_unique
    intro x _
    have hx : (fullPeriodLine D w).mkQ x = (fullPeriodLine D w).mkQ 0 :=
      @Subsingleton.elim (Full D w ⧸ fullPeriodLine D w) h _ _
    have hx0 : (fullPeriodLine D w).mkQ x = 0 := by
      simpa only [map_zero] using hx
    exact (Submodule.Quotient.mk_eq_zero _).mp hx0
  · intro h
    constructor
    intro a b
    obtain ⟨x, rfl⟩ := (fullPeriodLine D w).mkQ_surjective a
    obtain ⟨y, rfl⟩ := (fullPeriodLine D w).mkQ_surjective b
    apply (Submodule.Quotient.eq _).mpr
    rw [h]
    trivial

end
end JoshiTeich.Act1Scene1.InitialThetaWittTwistedQuotient
