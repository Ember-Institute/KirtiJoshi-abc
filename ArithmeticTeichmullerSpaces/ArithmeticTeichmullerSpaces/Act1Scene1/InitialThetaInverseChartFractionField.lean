local instance infinityInverseFieldAmbientTower :
    IsScalarTower (↥S.prime.torsionField) S.infinityTranslationBaseField
      (Genuine.Ω S.prime.EK) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

abbrev infinityInverseU : S.infinityTranslationBaseField :=
  S.infinityTranslationInverseFirstCoordinate
abbrev infinityInverseV : S.infinityTranslationBaseField :=
  S.infinityTranslationInverseSecondCoordinate

/-- The field generated by the actual inverse coordinates. -/
abbrev infinityInverseChartField :=
  IntermediateField.adjoin (↥S.prime.torsionField)
    ({S.infinityInverseU, S.infinityInverseV} : Set S.infinityTranslationBaseField)

theorem infinityInverseChartField_eq_top : S.infinityInverseChartField = ⊤ := by
  let k := ↥S.prime.torsionField
  let F := S.infinityTranslationBaseField
  let Ω := Genuine.Ω S.prime.EK
  let H : IntermediateField k F := S.infinityInverseChartField
  let ι : F →ₐ[k] Ω := IsScalarTower.toAlgHom k F Ω
  let L : IntermediateField k Ω := H.map ι
  have hu : WeierstrassInverseChart.firstCoordinate S.prime.EK ∈ L := by
    apply (IntermediateField.mem_map H).mpr
    refine ⟨S.infinityInverseU, IntermediateField.subset_adjoin _ _ (by simp), ?_⟩
    exact S.coe_infinityTranslationInverseFirstCoordinate
  have hv : WeierstrassInverseChart.secondCoordinate S.prime.EK ∈ L := by
    apply (IntermediateField.mem_map H).mpr
    refine ⟨S.infinityInverseV, IntermediateField.subset_adjoin _ _ (by simp), ?_⟩
    exact S.coe_infinityTranslationInverseSecondCoordinate
  have hx : Genuine.xG S.prime.EK ∈ L := by
    have h := L.inv_mem hu
    have heq : (WeierstrassInverseChart.firstCoordinate S.prime.EK)⁻¹ =
        Genuine.xG S.prime.EK := inv_inv _
    exact (congrArg (fun z : Ω => z ∈ L) heq).mp h
  have hxn : Genuine.xG S.prime.EK ≠ 0 :=
    (Genuine.transcendental_xG S.prime.EK).ne_zero
  have hy : Genuine.yG S.prime.EK ∈ L := by
    have h := L.mul_mem hv (L.pow_mem hx 2)
    have heq : WeierstrassInverseChart.secondCoordinate S.prime.EK *
        Genuine.xG S.prime.EK ^ 2 = Genuine.yG S.prime.EK := by
      dsimp [WeierstrassInverseChart.secondCoordinate]
      field_simp [hxn]
    exact (congrArg (fun z : Ω => z ∈ L) heq).mp h
  have hbase : Genuine.baseField S.prime.EK ≤ L := by
    rw [Genuine.baseField_eq_xLine S.prime.EK]
    change IntermediateField.adjoin k {Genuine.xG S.prime.EK} ≤ L
    apply IntermediateField.adjoin_le_iff.mpr
    intro a ha
    rw [Set.mem_singleton_iff] at ha
    subst a
    exact hx
  let L' : IntermediateField (Genuine.baseField S.prime.EK) Ω :=
    L.toSubfield.toIntermediateField (K := Genuine.baseField S.prime.EK)
      (fun a => hbase a.property)
  have hQ : Genuine.QField S.prime.EK 1 ≤ L' := by
    rw [Genuine.QField_one_coordinates S.prime.EK, IntermediateField.adjoin_le_iff]
    rintro a (rfl | rfl)
    · exact hx
    · exact hy
  apply top_unique
  intro z _
  have hz : ((z : F) : Ω) ∈ Genuine.QField S.prime.EK 1 := by
    have hp := z.property
    -- Both rebasing and normalizationField retain the same ambient membership.
    change (z : Ω) ∈ Genuine.stabilizerField S.prime.EK S.prime.ℓ S.prime.TK false at hp
    rw [S.fullTorsionTranslationField_eq_levelOne,
      Genuine.stabilizerField_bot_false_eq_QField S.prime.EK 1] at hp
    exact hp
  obtain ⟨w, hw, heq⟩ := (IntermediateField.mem_map H).mp (hQ hz : (z : Ω) ∈ L)
  have hW : w = z := Subtype.ext heq
  exact hW ▸ hw

/-- The fraction-field API needed by the actual raw-chart localization.
This base ring is the existing B ⊂ C, rather than a replacement B ⊂ F. -/
theorem infinityInverseRawChart_isFractionRing :
    IsFractionRing S.infinityInverseRawChart S.infinityTranslationBaseField := by
  letI : Algebra S.infinityTranslationBaseRing S.infinityTranslationBaseField :=
    S.infinityTranslationBaseRing.toAlgebra
  letI : SMul (↥S.prime.torsionField) S.infinityTranslationBaseRing :=
    S.infinityTranslationBaseRing_coefficientAlgebra.toSMul
  letI : SMul (↥S.prime.torsionField) S.infinityTranslationBaseField :=
    S.infinityTranslationBaseField_coefficientAlgebra.toSMul
  letI : SMul S.infinityTranslationBaseRing S.infinityTranslationBaseField :=
    (inferInstance : Algebra S.infinityTranslationBaseRing S.infinityTranslationBaseField).toSMul
  letI : IsScalarTower (↥S.prime.torsionField)
      S.infinityTranslationBaseRing S.infinityTranslationBaseField :=
    IsScalarTower.of_algebraMap_eq
      (R := ↥S.prime.torsionField) (S := S.infinityTranslationBaseRing)
      (A := S.infinityTranslationBaseField) (fun _ => rfl)
  letI : FaithfulSMul S.infinityTranslationBaseRing S.infinityTranslationBaseField := by
    rw [faithfulSMul_iff_algebraMap_injective]
    exact Subtype.val_injective
  exact AdjoinSubringFractionField.isFractionRing_adjoin_pair
    (k := ↥S.prime.torsionField)
    (F := S.infinityTranslationBaseField)
    S.infinityTranslationInverseFirstCoordinate
    S.infinityTranslationInverseSecondCoordinate
    S.infinityInverseChartField_eq_top

end
