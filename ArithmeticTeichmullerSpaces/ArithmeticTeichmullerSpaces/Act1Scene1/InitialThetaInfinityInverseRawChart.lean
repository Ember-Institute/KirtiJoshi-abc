variable {AG : AnabelianGeometry.{u}} {TG : TemperedGeometry AG}
variable (S : InitialThetaGeometrySeed AG TG)

/-- The actual raw inverse chart inside the existing lower normalization ring. -/
abbrev infinityInverseRawChart :
    Subalgebra ↥S.prime.torsionField S.infinityTranslationBaseRing :=
  InverseChartRawAlgebra.coordinateAlgebra ↥S.prime.torsionField
    S.infinityTranslationInverseFirstCoordinate S.infinityTranslationInverseSecondCoordinate

/-- The ideal generated by the two actual inverse coordinates in the raw chart. -/
def infinityInverseRawOriginIdeal : Ideal S.infinityInverseRawChart :=
  InverseChartRawAlgebra.originIdeal ↥S.prime.torsionField
    S.infinityTranslationInverseFirstCoordinate S.infinityTranslationInverseSecondCoordinate

/-- The center of an actual lower infinity prime on the raw inverse chart. -/
def infinityInverseRawChart_center (q : S.infinityTranslationBaseFiber) :
    Ideal S.infinityInverseRawChart :=
  q.1.comap S.infinityInverseRawChart.val.toRingHom

/-- Both actual coordinate memberships force containment of the raw origin ideal. -/
theorem infinityInverseRawOriginIdeal_le_center (q : S.infinityTranslationBaseFiber) :
    S.infinityInverseRawOriginIdeal ≤ S.infinityInverseRawChart_center q :=
  InverseChartRawAlgebra.originIdeal_le_comap ↥S.prime.torsionField
    S.infinityTranslationInverseFirstCoordinate S.infinityTranslationInverseSecondCoordinate q.1
    (S.infinityTranslationInverseFirstCoordinate_mem_fiber q)
    (S.infinityTranslationInverseSecondCoordinate_mem_fiber q)

private def infinityInverseRawChart_witness : S.infinityTranslationBaseFiber :=
  Classical.choice (FunctionFieldNormalization.zeroFiber_nonempty
    (Genuine.xG S.prime.EK)⁻¹ S.infinityTranslation_inverseCoordinate_transcendental
    S.infinityTranslationBaseField)

/-- An existing actual lower infinity prime certifies that the raw origin is maximal. -/
theorem infinityInverseRawOriginIdeal_isMaximal :
    S.infinityInverseRawOriginIdeal.IsMaximal :=
  InverseChartRawAlgebra.originIdeal_isMaximal_of_prime
    (k := ↥S.prime.torsionField)
    S.infinityTranslationInverseFirstCoordinate S.infinityTranslationInverseSecondCoordinate
    S.infinityInverseRawChart_witness.1 S.infinityInverseRawChart_witness.2.1
    (S.infinityTranslationInverseFirstCoordinate_mem_fiber S.infinityInverseRawChart_witness)
    (S.infinityTranslationInverseSecondCoordinate_mem_fiber S.infinityInverseRawChart_witness)

/-- Every actual lower infinity prime has the raw inverse-chart origin as its center. -/
theorem infinityInverseRawChart_center_eq_origin (q : S.infinityTranslationBaseFiber) :
    S.infinityInverseRawChart_center q = S.infinityInverseRawOriginIdeal := by
  have hproper : S.infinityInverseRawChart_center q ≠ ⊤ :=
    Ideal.comap_ne_top S.infinityInverseRawChart.val.toRingHom q.2.1.ne_top
  exact (S.infinityInverseRawOriginIdeal_isMaximal.eq_of_le hproper
    (S.infinityInverseRawOriginIdeal_le_center q)).symm

end
