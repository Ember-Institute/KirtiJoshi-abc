import ArithmeticTeichmullerSpaces.Act1Scene1.LocalCompletionTensor
import ArithmeticTeichmullerSpaces.Act1Scene1.IutInitialThetaLogBallNorm

/-!
source-id: JT-SCENE1-INITIAL-THETA-TENSOR-WITNESS
source: Joshi III `le:volume-lemma2`, `le:volume-lemma3`; actual canonical
q-root logarithm values and their integral scalar balls.
fidelity: constructs a nonzero pure tensor and its integral-ball lattice
inside the actual completion tensor over a common residue prime, and
proves containment in the tensor log-shell. The tuple is explicit; paper
representatives, different untilts, tensor volume and hull remain open.
boundary: Scene1/Derived
-/

namespace JoshiTeich.Act1Scene1.InitialThetaTensorWitness

open JoshiTeich.Prologue NumberField

universe u
noncomputable section

variable {AG : JoshiTeich.ReferenceIut.AnabelianGeometry.{u}}
variable {TG : JoshiTeich.ReferenceIut.TemperedGeometry AG}
variable (D : JoshiTeich.ReferenceIut.InitialThetaData AG TG)
variable (p : ℕ) [Fact p.Prime] {ι : Type} [Fintype ι]
variable (c : ι → (IutTorsionQRootSource.ofInitialThetaDataFromGlobal D).badFinset)
variable (hc : ∀ i, Arithmetic.residueChar (c i).1 = p)

def packet : LocalCompletion.Packet ↥D.prime.torsionField p ι :=
  ⟨fun i => (c i).1, hc⟩

/-- The actual canonical logarithm values form a tensor in the common p-adic packet. -/
def value : (packet D p c hc).Tensor :=
  (packet D p c hc).pure (fun i => InitialThetaLogWitness.value D (c i))

/-- The integral tensor lattice generated by the actual scalar integral balls. -/
def region :=
  (packet D p c hc).lattice (fun i => InitialThetaLogWitness.integralBall D (c i))

theorem value_ne_zero : value D p c hc ≠ 0 := by
  apply LocalCompletion.Packet.pure_ne_zero
  intro i
  exact InitialThetaLogWitness.value_ne_zero D (c i)

theorem value_mem_region : value D p c hc ∈ region D p c hc := by
  apply LocalCompletion.Packet.pure_mem_lattice
  intro i
  exact InitialThetaLogWitness.value_mem_integralBall D (c i)

theorem region_le_unitLattice : region D p c hc ≤ (packet D p c hc).unitLattice := by
  apply LocalCompletion.Packet.lattice_mono
  intro i
  rw [InitialThetaLogWitness.integralBall_eq_closedBall D (c i)]
  exact Metric.closedBall_subset_closedBall
    (IutTorsionQRootSource.ofInitialThetaDataFromGlobal_qroot_norm_lt_one D (c i)).le

theorem region_le_tensorLogShell : region D p c hc ≤ (packet D p c hc).tensorLogShell :=
  (region_le_unitLattice D p c hc).trans
    (LocalCompletion.Packet.unitLattice_le_tensorLogShell (packet D p c hc))

theorem value_mem_tensorLogShell : value D p c hc ∈ (packet D p c hc).tensorLogShell :=
  region_le_tensorLogShell D p c hc (value_mem_region D p c hc)

end
end JoshiTeich.Act1Scene1.InitialThetaTensorWitness
