import ArithmeticTeichmullerSpaces.Act1Scene1.IutInitialThetaQRootKummerSeparation
import ArithmeticTeichmullerSpaces.Act1Scene1.IutInitialThetaNormalizedClassUnitSaturatedIntersection

/-!
source-id: JT-SCENE1-ACTUAL-QROOT-OUTSIDE-NORMALIZED-SPAN
source: the actual contracting q-root Kummer class, the normalized principal-unit
class, and the saturated principal-Kummer Q_p module (Joshi III 3190--3236).
fidelity: proves that the q-root class is outside the Q_p line generated by the
normalized principal-unit class. This is an ambient linear separation result;
it does not identify the line with H¹ₑ or Bloch--Kato.
boundary: Scene1/Derived
-/

namespace JoshiTeich.Act1Scene1.PrincipalUnitKummer
open JoshiTeich.Prologue
open scoped Valued
universe u
noncomputable section
variable {AG : JoshiTeich.ReferenceIut.AnabelianGeometry.{u}}
variable {TG : JoshiTeich.ReferenceIut.TemperedGeometry AG}
variable (D : JoshiTeich.ReferenceIut.InitialThetaData AG TG)

local instance qrootSpanPrime
    (s : (iutInitialThetaOddSupportTorsionQRootSource D).badFinset) :
    Fact (Arithmetic.residueChar s.1).Prime :=
  ⟨Arithmetic.residueChar_prime s.1⟩

local instance qrootSpanCharZero
    (s : (iutInitialThetaOddSupportTorsionQRootSource D).badFinset) :
    CharZero (localField D s) :=
  charZero_of_injective_ringHom (NumberField.FinitePlace.embedding s.1.maximalIdeal).injective

local instance qrootSpanAlgebra
    (s : (iutInitialThetaOddSupportTorsionQRootSource D).badFinset) :
    Algebra ℚ_[Arithmetic.residueChar s.1] (localField D s) :=
  LocalCompletion.padicAlgebra (w := s.1) rfl

local instance qrootSpanContinuousSMul
    (s : (iutInitialThetaOddSupportTorsionQRootSource D).badFinset) :
    ContinuousSMul ℚ_[Arithmetic.residueChar s.1] (localField D s) :=
  continuousSMul_of_algebraMap _ _ (LocalCompletion.continuous_padicEmb (w := s.1) rfl)

set_option maxHeartbeats 1000000 in
theorem qrootRationalKummerClass_not_mem_normalized_span
    (s : (iutInitialThetaOddSupportTorsionQRootSource D).badFinset) :
    qrootRationalKummerClass D s ∉
      ℚ_[Arithmetic.residueChar s.1] ∙ normalizedRationalClass D s := by
  intro h
  obtain ⟨c, hc⟩ := (Submodule.mem_span_singleton.mp h)
  apply qrootRationalKummerClass_not_mem_saturated D s
  rw [← hc]
  exact LocalPadicLog.padic_smul_mem_saturatedKummerImage
    (Arithmetic.residueChar s.1)
    (InitialThetaLogWitness.norm_residueChar_lt_one s.1) c
    (normalizedRationalClass_mem_saturatedImage D s)

end
end JoshiTeich.Act1Scene1.PrincipalUnitKummer
