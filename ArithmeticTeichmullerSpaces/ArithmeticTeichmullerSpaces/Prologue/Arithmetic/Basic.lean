import Mathlib.NumberTheory.NumberField.Discriminant.Different
import Mathlib.NumberTheory.NumberField.Completion.FinitePlace
import Mathlib.RingTheory.RamificationInertia.Basic

namespace JoshiTeich.Prologue.Arithmetic

open scoped BigOperators NumberField
open WithZero

variable {K : Type*} [Field K] [NumberField K]

/-!
This finite-place arithmetic API is ported from `iut`'s Corollary 3.12
`ThetaData/Places` layer and its concrete `Concrete/LocalTheory` layer.  It is
a local definition over the mathlib finite-place carrier; no `iut` module is
imported as a dependency.
-/

/-- The ramification index of a finite place over its residue characteristic. -/
noncomputable def ramIdx (w : NumberField.FinitePlace K) : ℕ :=
  Ideal.ramificationIdx w.maximalIdeal.asIdeal ℤ

/-- The residue degree of a finite place over its residue characteristic. -/
noncomputable def inertDeg (w : NumberField.FinitePlace K) : ℕ :=
  Ideal.inertiaDeg w.maximalIdeal.asIdeal ℤ

/-- The local degree `[K_w : ℚ_p] = e_w f_w`. -/
noncomputable def localDeg (w : NumberField.FinitePlace K) : ℕ :=
  ramIdx w * inertDeg w

/-- The normalized arithmetic degree weight `[K_w : ℚ_p]/[K : ℚ]`. -/
noncomputable def placeWeight (w : NumberField.FinitePlace K) : ℝ :=
  (localDeg w : ℝ) / Module.finrank ℚ K

/-- The q-divisor weight used by the `iut` q-pilot: residue degree divided by
the global degree.  The ramification index belongs to the local valuation
normalization and is not part of this q-pilot coefficient. -/
noncomputable def qPilotWeight (w : NumberField.FinitePlace K) : ℝ :=
  (inertDeg w : ℝ) / Module.finrank ℚ K

lemma ramIdx_pos (w : NumberField.FinitePlace K) : 0 < ramIdx w := by
  exact w.maximalIdeal.asIdeal.ramificationIdx_pos ℤ

lemma inertDeg_pos (w : NumberField.FinitePlace K) : 0 < inertDeg w := by
  exact w.maximalIdeal.asIdeal.inertiaDeg_pos ℤ

lemma localDeg_pos (w : NumberField.FinitePlace K) : 0 < localDeg w := by
  exact Nat.mul_pos (ramIdx_pos w) (inertDeg_pos w)

lemma finrank_pos : (0 : ℝ) < Module.finrank ℚ K := by
  exact_mod_cast Module.finrank_pos

lemma placeWeight_pos (w : NumberField.FinitePlace K) : 0 < placeWeight w := by
  exact div_pos (by exact_mod_cast localDeg_pos w) finrank_pos

lemma qPilotWeight_pos (w : NumberField.FinitePlace K) : 0 < qPilotWeight w := by
  exact div_pos (by exact_mod_cast inertDeg_pos w) finrank_pos

/-!
The `iut` q-pilot uses residue degrees, while the standard finite-place
identity controls the larger local degrees `e_w f_w`.  This bridge records the
part that is independent of the place-to-`primesOver` indexing dictionary:
any finite set whose local degrees sum to at most `[K : ℚ]` has total q-pilot
weight at most one.
-/
lemma qPilotWeight_sum_le_one_of_localDeg_sum_le
    (S : Finset (NumberField.FinitePlace K))
    (hS : ∑ w ∈ S, localDeg w ≤ Module.finrank ℚ K) :
    ∑ w ∈ S, qPilotWeight w ≤ 1 := by
  have hPoint : ∀ w ∈ S, (inertDeg w : ℝ) ≤ (localDeg w : ℝ) := by
    intro w hw
    unfold localDeg
    exact_mod_cast Nat.le_mul_of_pos_left _ (ramIdx_pos w)
  have hInert :
      ∑ w ∈ S, (inertDeg w : ℝ) ≤ (Module.finrank ℚ K : ℝ) := by
    calc
      ∑ w ∈ S, (inertDeg w : ℝ) ≤ ∑ w ∈ S, (localDeg w : ℝ) := by
        exact Finset.sum_le_sum fun w hw => hPoint w hw
      _ ≤ (Module.finrank ℚ K : ℝ) := by
        exact_mod_cast hS
  have hRank : (0 : ℝ) < Module.finrank ℚ K := finrank_pos
  unfold qPilotWeight
  rw [← Finset.sum_div]
  calc
    (∑ w ∈ S, (inertDeg w : ℝ)) / Module.finrank ℚ K ≤
        (Module.finrank ℚ K : ℝ) / Module.finrank ℚ K :=
      div_le_div_of_nonneg_right hInert hRank.le
    _ = 1 := by field_simp

noncomputable def residueChar (w : NumberField.FinitePlace K) : ℕ :=
  ringChar (𝓞 K ⧸ w.maximalIdeal.asIdeal)

lemma residueChar_prime (w : NumberField.FinitePlace K) : (residueChar w).Prime := by
  haveI : w.maximalIdeal.asIdeal.IsMaximal :=
    w.maximalIdeal.isPrime.isMaximal w.maximalIdeal.ne_bot
  letI : Field (𝓞 K ⧸ w.maximalIdeal.asIdeal) := Ideal.Quotient.field _
  haveI : Finite (𝓞 K ⧸ w.maximalIdeal.asIdeal) :=
    Ring.HasFiniteQuotients.finiteQuotient w.maximalIdeal.ne_bot
  exact CharP.char_is_prime (𝓞 K ⧸ w.maximalIdeal.asIdeal) (ringChar _)

/-- A finite place lies over the integer prime ideal generated by its residue
characteristic.  This is the ideal-theoretic `w ∣ p` relation used by the
`iut` ThetaData/Places layer. -/
lemma residueChar_liesOver (w : NumberField.FinitePlace K) :
    Ideal.LiesOver w.maximalIdeal.asIdeal
      (Ideal.span {(residueChar w : ℤ)}) := by
  unfold residueChar
  simpa [Ideal.ringChar_quot] using
    (Int.liesOver_span_absNorm w.maximalIdeal.asIdeal)

/-- The absolute norm of a finite place is the residue characteristic raised to
its residue degree.  This is the finite-place norm identity used by the `iut`
completion/uniformizer layer. -/
lemma absNorm_eq_pow_residueChar (w : NumberField.FinitePlace K) :
    Ideal.absNorm w.maximalIdeal.asIdeal = residueChar w ^ inertDeg w := by
  haveI := residueChar_liesOver w
  exact (Ideal.pow_inertiaDeg (residueChar w) w.maximalIdeal.asIdeal).symm

/-- The completion norm of an element with discrete valuation `exp m` is the
residue-characteristic norm raised to that valuation.  This is the local
completion identity used by the `iut` uniformizer layer. -/
lemma completionNorm_eq_residueChar_pow_of_valued
    (w : NumberField.FinitePlace K)
    (x : w.maximalIdeal.adicCompletion K) (m : ℤ)
    (hx : Valued.v x = exp m) :
    ‖x‖ = ((residueChar w : ℝ) ^ inertDeg w) ^ m := by
  rw [NumberField.FinitePlace.norm_def, hx,
    WithZeroMulInt.toNNReal_neg_apply _ exp_ne_zero]
  simp only [WithZero.log_exp]
  rw [NNReal.coe_zpow, NNReal.coe_natCast, absNorm_eq_pow_residueChar,
    Nat.cast_pow]

/-!
The finite-support fact used by the `iut` bad-place layer is independent of
the elliptic-curve presentation: for a nonzero field element, only finitely
many finite places can have norm strictly larger than one.  The zero case is
empty and is handled explicitly so the public carrier has no side condition.
-/
lemma finite_places_norm_gt_one (x : K) :
    {w : NumberField.FinitePlace K | 1 < w x}.Finite := by
  by_cases hx : x = 0
  · subst x
    have hempty :
        ({w : NumberField.FinitePlace K | 1 < w (0 : K)} :
          Set (NumberField.FinitePlace K)) = ∅ := by
      ext w
      simp
    rw [hempty]
    exact Set.finite_empty
  · refine (NumberField.FinitePlace.hasFiniteMulSupport hx).subset ?_
    intro w hw
    simp only [Function.mem_mulSupport]
    exact ne_of_gt hw

noncomputable def normGtOneFinset (x : K) :
    Finset (NumberField.FinitePlace K) :=
  (finite_places_norm_gt_one x).toFinset

lemma mem_normGtOneFinset_iff (x : K) (w : NumberField.FinitePlace K) :
    w ∈ normGtOneFinset x ↔ 1 < w x := by
  rw [normGtOneFinset, Set.Finite.mem_toFinset]
  rfl

/-!
The finite-place index dictionary used by the `iut` arithmetic layer is now
closed for the frozen mathlib carrier.  Filtering any explicit finite set by
the residue characteristic gives a subset of the primes over `(q)`, so the
Dedekind-domain fundamental identity supplies the local-degree bound.
-/
lemma localDeg_sum_le_finrank_of_residueChar_filter
    (S : Finset (NumberField.FinitePlace K)) (q : ℕ) (hq : q.Prime) :
    ∑ w ∈ S.filter (fun w => residueChar w = q), localDeg w ≤
      Module.finrank ℚ K := by
  classical
  set p : Ideal ℤ := Ideal.span {(q : ℤ)} with hp
  haveI hmax : p.IsMaximal := by
    haveI hprime : p.IsPrime := by
      rw [hp]
      exact (Ideal.span_singleton_prime (by exact_mod_cast hq.ne_zero)).2
        (Nat.prime_iff_prime_int.1 hq)
    exact IsPrime.to_maximal_ideal (by
      rw [hp, ne_eq, Ideal.span_singleton_eq_bot]
      exact_mod_cast hq.ne_zero)
  have hp0 : p ≠ ⊥ := by
    rw [hp, ne_eq, Ideal.span_singleton_eq_bot]
    exact_mod_cast hq.ne_zero
  have hsum :
      ∑ P ∈ IsDedekindDomain.primesOverFinset p (𝓞 K),
          P.ramificationIdx ℤ * P.inertiaDeg ℤ = Module.finrank ℚ K := by
    have hsum0 := Ideal.sum_ramification_inertia_eq_finrank p (𝓞 K)
    classical
    calc
      ∑ P ∈ IsDedekindDomain.primesOverFinset p (𝓞 K),
          P.ramificationIdx ℤ * P.inertiaDeg ℤ =
          ∑ Q : p.primesOver (𝓞 K),
            Q.1.ramificationIdx ℤ * Q.1.inertiaDeg ℤ := by
        symm
        refine Finset.sum_bij (fun Q _ => Q.1) ?_ ?_ ?_ ?_
        · intro Q _
          exact (IsDedekindDomain.mem_primesOverFinset_iff hp0 (𝓞 K)).mpr Q.2
        · intro Q₁ _ Q₂ _ hQ
          exact Subtype.ext hQ
        · intro P hP
          have hP' := (IsDedekindDomain.mem_primesOverFinset_iff hp0 (𝓞 K)).mp hP
          exact ⟨⟨P, hP'⟩, Finset.mem_univ _, rfl⟩
        · intro Q _
          rfl
      _ = Module.finrank ℚ K := by
        simpa only [NumberField.RingOfIntegers.rank] using hsum0
  set T := S.filter (fun w => residueChar w = q) with hT
  have hle : ∀ w ∈ T,
      localDeg w ≤
        w.maximalIdeal.asIdeal.ramificationIdx ℤ *
          w.maximalIdeal.asIdeal.inertiaDeg ℤ := by
    intro w hw
    unfold localDeg ramIdx inertDeg
    exact Nat.le_refl _
  have hsub : T.image (fun w : NumberField.FinitePlace K =>
      w.maximalIdeal.asIdeal) ⊆
      IsDedekindDomain.primesOverFinset p (𝓞 K) := by
    intro P hP
    rw [Finset.mem_image] at hP
    obtain ⟨w, hw, rfl⟩ := hP
    rw [hT, Finset.mem_filter] at hw
    haveI : Ideal.LiesOver w.maximalIdeal.asIdeal p := by
      rw [hp, ← hw.2]
      exact residueChar_liesOver w
    exact (IsDedekindDomain.mem_primesOverFinset_iff hp0 (𝓞 K)).mpr
      ⟨inferInstance, inferInstance⟩
  have hinj : Set.InjOn
      (fun w : NumberField.FinitePlace K => w.maximalIdeal.asIdeal) T := by
    intro w₁ _ w₂ _ h
    exact NumberField.FinitePlace.maximalIdeal_injective
      (IsDedekindDomain.HeightOneSpectrum.ext h)
  calc
    ∑ w ∈ T, localDeg w ≤
        ∑ w ∈ T,
          w.maximalIdeal.asIdeal.ramificationIdx ℤ *
            w.maximalIdeal.asIdeal.inertiaDeg ℤ :=
      Finset.sum_le_sum hle
    _ = ∑ P ∈ T.image (fun w : NumberField.FinitePlace K =>
          w.maximalIdeal.asIdeal),
          P.ramificationIdx ℤ * P.inertiaDeg ℤ :=
      (Finset.sum_image
        (f := fun P => P.ramificationIdx ℤ * P.inertiaDeg ℤ) hinj).symm
    _ ≤ ∑ P ∈ IsDedekindDomain.primesOverFinset p (𝓞 K),
          P.ramificationIdx ℤ * P.inertiaDeg ℤ :=
      Finset.sum_le_sum_of_subset hsub
    _ = Module.finrank ℚ K := hsum

lemma qPilotWeight_sum_le_one_of_residueChar_filter
    (S : Finset (NumberField.FinitePlace K)) (q : ℕ) (hq : q.Prime) :
    ∑ w ∈ S.filter (fun w => residueChar w = q), qPilotWeight w ≤ 1 := by
  exact qPilotWeight_sum_le_one_of_localDeg_sum_le
    (S.filter (fun w => residueChar w = q))
    (localDeg_sum_le_finrank_of_residueChar_filter S q hq)

/-!
The following two lemmas are the local arithmetic part of the `iut`
`CurveArithmetic` layer.  They make the rational-prime label recoverable from
the ideal relation, and preserve that label across a finite-place extension.
-/

lemma natCast_mem_maximalIdeal_iff (w : NumberField.FinitePlace K)
    {q : ℕ} (hq : q.Prime) :
    (q : 𝓞 K) ∈ w.maximalIdeal.asIdeal ↔ residueChar w = q := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_natCast,
    CharP.cast_eq_zero_iff (𝓞 K ⧸ w.maximalIdeal.asIdeal) (ringChar _)]
  exact Nat.prime_dvd_prime_iff_eq (residueChar_prime w) hq

lemma residueChar_eq_of_liesOver
    {k K : Type*} [Field k] [NumberField k] [Field K] [NumberField K]
    [Algebra k K] {w : NumberField.FinitePlace K}
    {v : NumberField.FinitePlace k}
    (hwv : Ideal.LiesOver w.maximalIdeal.asIdeal v.maximalIdeal.asIdeal) :
    residueChar w = residueChar v := by
  haveI : w.maximalIdeal.asIdeal.LiesOver v.maximalIdeal.asIdeal := hwv
  haveI : v.maximalIdeal.asIdeal.IsMaximal :=
    v.maximalIdeal.isPrime.isMaximal v.maximalIdeal.ne_bot
  letI : Field (𝓞 k ⧸ v.maximalIdeal.asIdeal) := Ideal.Quotient.field _
  haveI : CharP (𝓞 k ⧸ v.maximalIdeal.asIdeal) (residueChar v) :=
    ringChar.of_eq rfl
  haveI : CharP (𝓞 K ⧸ w.maximalIdeal.asIdeal) (residueChar v) :=
    charP_of_injective_algebraMap
      (algebraMap (𝓞 k ⧸ v.maximalIdeal.asIdeal)
        (𝓞 K ⧸ w.maximalIdeal.asIdeal)).injective
      (residueChar v)
  exact ringChar.eq _ (residueChar v)

/-!
Finite-place divisors are the arithmetic support used by the height and
different/conductor interfaces.  The support and exponents are data; the
nonzero-exponent condition prevents an empty encoding of a supported divisor.
-/
structure FinitePlaceDivisor (K : Type*) [Field K] [NumberField K] where
  support : Finset (NumberField.FinitePlace K)
  exponent : NumberField.FinitePlace K → ℕ
  exponent_ne_zero : ∀ w ∈ support, exponent w ≠ 0

namespace FinitePlaceDivisor

noncomputable def logDegree (D : FinitePlaceDivisor K) : ℝ :=
  ∑ w ∈ D.support,
    (D.exponent w : ℝ) * Real.log (Ideal.absNorm w.maximalIdeal.asIdeal : ℝ)

lemma logDegree_nonneg (D : FinitePlaceDivisor K) : 0 ≤ D.logDegree := by
  unfold logDegree
  refine Finset.sum_nonneg fun w hw ↦ mul_nonneg (Nat.cast_nonneg _) ?_
  exact Real.log_nonneg (by
    exact_mod_cast (NumberField.HeightOneSpectrum.one_lt_absNorm w.maximalIdeal).le)

lemma logDegree_pos_of_nonempty (D : FinitePlaceDivisor K) (hD : D.support.Nonempty) :
    0 < D.logDegree := by
  classical
  obtain ⟨w, hw⟩ := hD
  have hw_exp : 0 < D.exponent w := Nat.pos_of_ne_zero (D.exponent_ne_zero w hw)
  have hw_norm : 1 < (Ideal.absNorm w.maximalIdeal.asIdeal : ℝ) := by
    exact_mod_cast (NumberField.HeightOneSpectrum.one_lt_absNorm w.maximalIdeal)
  have hw_log : 0 < Real.log (Ideal.absNorm w.maximalIdeal.asIdeal : ℝ) :=
    Real.log_pos hw_norm
  refine Finset.sum_pos' (fun w' hw' ↦ ?_) ⟨w, hw, mul_pos (Nat.cast_pos.mpr hw_exp) hw_log⟩
  have hw'_norm : (1 : ℝ) < (Ideal.absNorm w'.maximalIdeal.asIdeal : ℝ) := by
    exact_mod_cast (NumberField.HeightOneSpectrum.one_lt_absNorm w'.maximalIdeal)
  exact mul_nonneg (Nat.cast_nonneg _) (Real.log_nonneg hw'_norm.le)

end FinitePlaceDivisor

/-!
An affine height profile records the finite-place part of the arithmetic height
formula from II.5.  Archimedean terms and arithmeticoid variation remain
separate source obligations instead of being hidden in an arbitrary function.
-/
structure HeightData (K : Type*) [Field K] [NumberField K] where
  places : Finset (NumberField.FinitePlace K)
  weight : NumberField.FinitePlace K → ℝ
  weight_nonneg : ∀ w ∈ places, 0 ≤ weight w
  value : K → ℝ
  value_eq : ∀ x,
    value x = ∑ w ∈ places, weight w * Real.log (max (w x) 1)

theorem HeightData.value_nonneg (H : HeightData K) (x : K) : 0 ≤ H.value x := by
  rw [H.value_eq]
  refine Finset.sum_nonneg fun w hw ↦
    mul_nonneg (H.weight_nonneg w hw) (Real.log_nonneg (le_max_right _ _))

/-! The different is the mathlib ideal; its norm is the absolute discriminant. -/
noncomputable def differentIdeal : Ideal (𝓞 K) :=
  _root_.differentIdeal ℤ (𝓞 K)

theorem differentIdeal_norm_eq_discriminant :
    Ideal.absNorm (differentIdeal (K := K)) = (NumberField.discr K).natAbs := by
  exact NumberField.absNorm_differentIdeal K (𝓞 K)

noncomputable def differentLog : ℝ :=
  Real.log (Ideal.absNorm (differentIdeal (K := K)) : ℝ)

theorem differentLog_nonneg : 0 ≤ differentLog (K := K) := by
  unfold differentLog
  apply Real.log_nonneg
  have hne : Ideal.absNorm (differentIdeal (K := K)) ≠ 0 := by
    change Ideal.absNorm (_root_.differentIdeal ℤ (𝓞 K)) ≠ 0
    intro h
    exact differentIdeal_ne_bot (Ideal.absNorm_eq_zero_iff.mp h)
  exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne

/-! A source-backed profile for the log-different/log-conductor quantities. -/
structure RamificationProfile (K : Type*) [Field K] [NumberField K] where
  conductor : FinitePlaceDivisor K
  different_log : ℝ
  conductor_log : ℝ
  different_log_nonneg : 0 ≤ different_log
  conductor_log_nonneg : 0 ≤ conductor_log

def RamificationProfile.logTotal (R : RamificationProfile K) : ℝ :=
  R.different_log + R.conductor_log

theorem RamificationProfile.logTotal_nonneg (R : RamificationProfile K) :
    0 ≤ R.logTotal := by
  exact add_nonneg R.different_log_nonneg R.conductor_log_nonneg

end JoshiTeich.Prologue.Arithmetic
