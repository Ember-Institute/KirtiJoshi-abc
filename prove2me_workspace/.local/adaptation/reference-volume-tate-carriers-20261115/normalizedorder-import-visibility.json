      "lines": [
        {
          "line": 19,
          "text": "Also creates a second \"builtin\" attribute used for bootstrapping, which saves"
        },
        {
          "line": 20,
          "text": "the applied declarations in an `IO.Ref` instead of an environment extension."
        },
        {
          "line": 104,
          "text": "def addBuiltin (attr : KeyedDeclsAttribute γ) (key : Key) (declName : Name) (value : γ) : IO Unit :="
        },
        {
          "line": 105,
          "text": "  attr.tableRef.modify fun m => m.insert { key, declName, value, isBuiltin := true }"
        },
        {
          "line": 119,
          "text": "  let tableRef ← IO.mkRef ({} : Table γ)"
        },
        {
          "line": 122,
          "text": "    mkInitial    := return mkStateOfTable (← tableRef.get)"
        }
      ]
    }
