private lemma hasSum_yFam_pos (p : ℕ) (u : Kˣ) :
    HasSum (fun m : ℤ =>
        (((t.q : K) ^ (p + 1)) ^ 2 * t.thetaProdFactor (-(t.q : K)) ^ 3
          * t.convYPos p (m - 2)) * (u : K) ^ m)
      (((t.q : K) ^ (p + 1)) ^ 2 * (u : K) ^ 2
        * (t.thetaProdFactor (-(t.q : K)) * t.pFactorSeries p (-((t.q : K) * (u : K)))
