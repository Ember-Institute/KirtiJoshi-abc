open AbcAdaptation.Reference.TateCurvesTheta
open scoped Classical

theorem solution
    {k : Type*} [NormedField k] [CompleteSpace k] [IsUltrametricDist k] [DecidableEq k]
    (t : TateParameter k) (hmem : t.TatePointEquation)
    (h12 : (12 : k) ≠ 0) (h2 : ‖(2 : k)‖ = 1) (u v : kˣ) :
    t.tatePoint hmem h12 (u * v) = t.tatePoint hmem h12 u + t.tatePoint hmem h12 v := by
  exact _root_.TateCurvesTheta.TateParameter.tatePoint_mul
    ⟨t.q, t.norm_lt_one⟩ hmem ⟨h2, h12⟩ u v

open Lean Elab Command in
run_cmd liftTermElabM do
  let target := (← getConstInfo `AbcAdaptation.Reference.TateCurvesTheta.TateParameter.tatePoint_mul).type
  let actual := (← getConstInfo `solution).type
  unless ← Meta.isDefEq actual target do
    throwError "The solution type differs from the platform statement"

