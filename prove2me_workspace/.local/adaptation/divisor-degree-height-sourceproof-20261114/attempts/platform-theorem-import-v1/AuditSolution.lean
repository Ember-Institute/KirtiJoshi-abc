/-- **Tuples with the same divisor have boundedly different heights.** -/
theorem abs_tupleHeight_sub_le_of_minOrd_eq {s : ι → K} {t : κ → K} (hs : ∃ i, s i ≠ 0)
    (ht : ∃ j, t j ≠ 0) (heq : ∀ P : Place K, minOrd P s = minOrd P t) :
