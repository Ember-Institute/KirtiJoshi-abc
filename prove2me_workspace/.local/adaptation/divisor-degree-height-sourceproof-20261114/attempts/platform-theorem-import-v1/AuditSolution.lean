theorem minOrd_single {r : K} (hr : r ≠ 0) (P : Place K) : minOrd P ![r] = P.ord r := by
  have hs : ∃ i, (![r] : Fin 1 → K) i ≠ 0 := ⟨0, by simpa using hr⟩
