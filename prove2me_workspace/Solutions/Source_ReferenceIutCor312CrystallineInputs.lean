import Solutions.Source_ReferenceIutCor312RootTowerPreTilt

/-!
Source: Joshi III, preliminary notation for the crystalline periods and
the standard-point comparison in (9.9.4)–(9.9.6).
The integral Teichmüller lifts are computed from the original Kummer and
cyclotomic towers. These ideal memberships are inputs to the divided-power
logarithmic series for the numerator and denominator of the period.
-/

set_option autoImplicit false

namespace JoshiTeich.Act1Scene1.LocalKummer.RootTower

open JoshiTeich.Prologue

universe u v w

noncomputable section

variable {K : Type u} [Field K] {Ω : Type v} [Field Ω] [Algebra K Ω]
variable {C : Type w} [NormedField C] [IsUltrametricDist C] [CompleteSpace C]
variable {p : ℕ} [Fact p.Prime] [Fact (0 < ‖(p : C)‖ ∧ ‖(p : C)‖ < 1)]

local notation "𝒪" => LocalGeometricFontaine.integerRing C
local notation "Ainf" => WittVector p (GeometricTiltField.Source C p)
local notation "θ" => (Perfectoid.thetaMap (O := 𝒪) (p := p))

/-- The cyclotomic Teichmüller difference lies in the Fontaine kernel. -/
theorem cyclotomic_teichmuller_sub_one_mem_theta_ker (ε : cyclotomicTateGroup p C) :
    WittVector.teichmuller p (CyclotomicTateTilt.toPreTilt C p ε) - 1 ∈
      RingHom.ker θ := by
  rw [RingHom.mem_ker, map_sub, map_one, sub_eq_zero, Perfectoid.thetaMap_teichmuller]
  exact CyclotomicTateTilt.untilt_toPreTilt C p ε

variable [IsAlgClosed C]
variable {a : K} (R : RootTower (Ω := Ω) p a) (j : Ω →+* C)
variable (ha : ‖j (algebraMap K Ω a)‖ ≤ 1)

/-- An integral principal unit supplies a Kummer Teichmüller difference in
the sum of the Fontaine kernel and the ideal generated by the prime. -/
theorem teichmuller_sub_one_mem_theta_ker_sup_prime
    (r : 𝒪) (hu : j (algebraMap K Ω a) = 1 + (p : C) * (r : C)) :
    WittVector.teichmuller p (toGeometricPreTilt R j ha) - 1 ∈
      RingHom.ker θ ⊔ Ideal.span {(p : Ainf)} := by
  let x := WittVector.teichmuller p (toGeometricPreTilt R j ha) - 1
  obtain ⟨y, hy⟩ := LocalGeometricFontaine.theta_surjective C p r
  have hθx : θ x = (p : 𝒪) * r := by
    apply Subtype.ext
    rw [show θ x = θ (WittVector.teichmuller p (toGeometricPreTilt R j ha)) - 1 by
      simp only [x, map_sub, map_one]]
    change (θ (WittVector.teichmuller p (toGeometricPreTilt R j ha)) : C) - 1 =
      (p : C) * (r : C)
    rw [theta_teichmuller_toGeometricPreTilt R j ha, hu, add_sub_cancel_left]
  have hk : x - (p : Ainf) * y ∈ RingHom.ker θ := by
    rw [RingHom.mem_ker, map_sub, map_mul, map_natCast, hy, hθx, sub_self]
  have hp : (p : Ainf) * y ∈ Ideal.span {(p : Ainf)} :=
    Ideal.mem_span_singleton.mpr (dvd_mul_right _ _)
  exact Submodule.mem_sup.mpr ⟨_, hk, _, hp, sub_add_cancel _ _⟩

end
end JoshiTeich.Act1Scene1.LocalKummer.RootTower
