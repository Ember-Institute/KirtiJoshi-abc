import Solutions.Source_ReferenceIutCor312CrystallineLog

set_option autoImplicit false

namespace JoshiTeich.Act1Scene1.CrystallineEnvelope

open JoshiTeich.Prologue

universe u v w

noncomputable section

variable (C : Type w) [NormedField C] [IsUltrametricDist C] [CompleteSpace C]
variable (p : ℕ) [Fact p.Prime] [Fact (0 < ‖(p : C)‖ ∧ ‖(p : C)‖ < 1)]

/-- The Witt vector to which the crystalline logarithm of a Teichmüller lift is applied. -/
def teichmullerSubOne (x : GeometricTiltField.Source C p) : Ainf C p :=
  WittVector.teichmuller p x - 1

/-- The Fontaine kernel together with the ideal generated by the residue prime. -/
def kerSupPrime : Ideal (Ainf C p) :=
  RingHom.ker (Perfectoid.thetaMap (O := LocalGeometricFontaine.integerRing C) (p := p)) ⊔
    Ideal.span {(p : Ainf C p)}

variable {K : Type u} [Field K] {Ω : Type v} [Field Ω] [Algebra K Ω]
variable {a : K} (R : LocalKummer.RootTower (Ω := Ω) p a) (j : Ω →+* C)
variable (ha : ‖j (algebraMap K Ω a)‖ ≤ 1)
variable (hu : ∃ r : LocalGeometricFontaine.integerRing C,
  j (algebraMap K Ω a) = 1 + (p : C) * (r : C))

include hu in
/-- The original Kummer coordinates give the logarithm input in the Fontaine ideal. -/
theorem kummerTeichmullerSubOne_mem_kerSupPrime [IsAlgClosed C] :
    teichmullerSubOne C p (R.toGeometricPreTilt j ha) ∈ kerSupPrime C p := by
  obtain ⟨r, hr⟩ := hu
  exact R.teichmuller_sub_one_mem_theta_ker_sup_prime j ha r hr

/-- The crystalline logarithm of an integral principal unit's original root tower. -/
def kummerLogOfExists [IsAlgClosed C] : ACris C p :=
  logOfMemKerSupPrime C p (teichmullerSubOne C p (R.toGeometricPreTilt j ha))
    (kummerTeichmullerSubOne_mem_kerSupPrime C p R j ha hu)

end

end JoshiTeich.Act1Scene1.CrystallineEnvelope
