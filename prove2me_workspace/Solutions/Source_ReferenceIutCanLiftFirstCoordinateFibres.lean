import Solutions.Source_ReferenceIutCanLiftAnalyticCovering
import Solutions.Source_ReferenceIutCanLiftDeckGroup
import Solutions.Source_ReferenceIutCanLiftInvariantCoordinates

set_option autoImplicit false

namespace AbcAdaptation.Reference.Iut.Anabelian.CanLiftAnalytic.IsUniformization

open UpperHalfPlane
open scoped MatrixGroups Pointwise

variable {W : WeierstrassCurve ℂ} [W.IsElliptic]
variable {A B : SL(2, ℝ)} {π : ℂ → ℂ × ℂ}

private theorem exists_mobius_lift_neg (h : IsUniformization W A B π) :
    ∃ d : SL(2, ℝ), ∀ τ : ℍ,
      π (d • τ : ℍ) = ((π τ).1, W.toAffine.negY (π τ).1 (π τ).2) := by
  obtain ⟨T, hT, hTπ⟩ := h.exists_lift_neg
  have hTc : Continuous T := UpperHalfPlane.isEmbedding_coe.continuous_iff.mpr
    (HolH.continuous (show HolH (fun τ : ℍ ↦ (T τ : ℂ)) from hT))
  have hTT (τ : ℍ) : π (T (T τ)) = π τ := by
    rw [hTπ, hTπ]
    exact Prod.ext rfl (W.toAffine.negY_negY _ _)
  let o := UpperHalfPlane.I
  obtain ⟨γ, hγ, ho⟩ := (h.fibre o (T (T o))).mp (hTT o).symm
  have heq : (fun τ ↦ T (T τ)) = (fun τ ↦ γ • τ) :=
    h.isCoveringMap.eq_of_comp_eq (A := ℍ) (hTc.comp hTc) (continuous_const_smul γ)
      (by
        funext τ
        exact (Subtype.ext (hTT τ) : h.toV (T (T τ)) = h.toV τ).trans
          (h.toV_smul hγ τ).symm) o ho.symm
  have hTTγ (τ : ℍ) : T (T τ) = γ • τ := congrFun heq τ
  let S : ℍ → ℍ := fun τ ↦ T (γ⁻¹ • τ)
  have hTS (τ : ℍ) : T (S τ) = τ := (hTTγ _).trans (smul_inv_smul _ _)
  have hTinj : Function.Injective T := by
    intro τ τ' hEq
    have hγeq := (hTTγ τ).symm.trans ((congrArg T hEq).trans (hTTγ τ'))
    simpa only [inv_smul_smul] using congrArg (fun t : ℍ ↦ γ⁻¹ • t) hγeq
  have hST (τ : ℍ) : S (T τ) = τ := hTinj (hTS (T τ))
  obtain ⟨d, hd⟩ := exists_SL2R_eq_of_holomorphic hT (hT.comp_smul γ⁻¹) hTS hST
  exact ⟨d, fun τ ↦ (congrArg (fun t : ℍ ↦ π t) (hd τ)).symm.trans (hTπ τ)⟩

private theorem mobius_lift_neg_mem_commensurator (h : IsUniformization W A B π)
    {d : SL(2, ℝ)}
    (hd : ∀ τ : ℍ, π (d • τ : ℍ) = ((π τ).1, W.toAffine.negY (π τ).1 (π τ).2)) :
    d ∈ Subgroup.Commensurable.commensurator (Subgroup.closure {A, B}) := by
  let G := Subgroup.closure {A, B}
  let P := pmGroup A B
  have hcomm : Subgroup.Commensurable G P := by
    refine ⟨relIndex_closure_pmGroup_ne_zero A B, ?_⟩
    rw [Subgroup.relIndex_eq_one.mpr (closure_le_pmGroup A B)]
    exact one_ne_zero
  let J : ℂ × ℂ → ℂ × ℂ := fun p ↦ (p.1, W.toAffine.negY p.1 p.2)
  have hJ (p : ℂ × ℂ) : J (J p) = p := Prod.ext rfl (W.toAffine.negY_negY _ _)
  have hinv (τ : ℍ) : π (d⁻¹ • τ : ℍ) = J (π τ) := by
    have he := congrArg J (hd (d⁻¹ • τ))
    change J (π (d • (d⁻¹ • τ) : ℍ)) = J (J (π (d⁻¹ • τ : ℍ))) at he
    rw [smul_inv_smul, hJ] at he
    exact he.symm
  have hmem (a b : SL(2, ℝ))
      (ha : ∀ τ : ℍ, π (a • τ : ℍ) = J (π τ))
      (hb : ∀ τ : ℍ, π (b • τ : ℍ) = J (π τ))
      (γ : SL(2, ℝ)) (hγ : γ ∈ P) : a * γ * b ∈ P := by
    apply h.mem_pmGroup_of_deck
    intro τ
    apply Subtype.ext
    change π ((a * γ * b) • τ : ℍ) = π τ
    have hπ := congrArg (fun v : V W ↦ v.1) (h.toV_smul_pm hγ (b • τ))
    change π (γ • (b • τ) : ℍ) = π (b • τ : ℍ) at hπ
    rw [mul_smul, mul_smul, ha, hπ, hb, hJ]
  have hconjInv (γ : SL(2, ℝ)) : (ConjAct.toConjAct d)⁻¹ • γ = d⁻¹ * γ * d := by
    rw [ConjAct.smul_def, ConjAct.ofConjAct_inv, ConjAct.ofConjAct_toConjAct, inv_inv]
  have hconj : ConjAct.toConjAct d • P = P := by
    ext γ
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, hconjInv]
    constructor
    · intro hγ
      have he : d * (d⁻¹ * γ * d) * d⁻¹ = γ := by group
      simpa only [he] using hmem d d⁻¹ hd hinv (d⁻¹ * γ * d) hγ
    · exact hmem d⁻¹ d hinv hd γ
  change d ∈ Subgroup.Commensurable.commensurator G
  rw [hcomm.eq, Subgroup.Commensurable.commensurator_mem_iff, hconj]

private def fstStabilizer (π : ℂ → ℂ × ℂ) : Subgroup SL(2, ℝ) where
  carrier := {g | ∀ τ : ℍ, (π (g • τ : ℍ)).1 = (π τ).1}
  one_mem' τ := by rw [one_smul]
  mul_mem' hg hg' τ := by rw [mul_smul, hg, hg']
  inv_mem' {g} hg τ := by
    have he := hg (g⁻¹ • τ)
    rw [smul_inv_smul] at he
    exact he.symm

/-- A subgroup of the deck group's commensurator has the first-coordinate fibers
as its orbits. It is generated by the deck generators and a lift of Weierstrass negation. -/
theorem exists_fst_fibre_group (h : IsUniformization W A B π) :
    ∃ Γ : Subgroup SL(2, ℝ),
      Subgroup.closure {A, B} ≤ Γ ∧
      Γ ≤ Subgroup.Commensurable.commensurator (Subgroup.closure {A, B}) ∧
      ∀ τ τ' : ℍ, (π τ).1 = (π τ').1 ↔ ∃ γ ∈ Γ, γ • τ = τ' := by
  obtain ⟨d, hd⟩ := h.exists_mobius_lift_neg
  let G := Subgroup.closure {A, B}
  let Γ := Subgroup.closure ((G : Set SL(2, ℝ)) ∪ {d})
  have hGΓ : G ≤ Γ := fun _ hγ ↦ Subgroup.subset_closure (Or.inl hγ)
  have hdΓ : d ∈ Γ := Subgroup.subset_closure (Or.inr (Set.mem_singleton d))
  have hΓfst : Γ ≤ fstStabilizer π := by
    apply (Subgroup.closure_le _).2
    rintro γ (hγ | hγ)
    · exact fun τ ↦ congrArg (fun p : V W ↦ p.1.1) (h.toV_smul hγ τ)
    · obtain rfl := Set.mem_singleton_iff.mp hγ
      intro τ
      have hfst := congrArg Prod.fst (hd τ)
      exact hfst
  refine ⟨Γ, hGΓ, ?_, ?_⟩
  · apply (Subgroup.closure_le _).2
    rintro γ (hγ | hγ)
    · have hγG : γ ∈ G := hγ
      have hconj : ConjAct.toConjAct γ • G = G := by
        ext g
        rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ConjAct.smul_def, ConjAct.ofConjAct_inv,
          ConjAct.ofConjAct_toConjAct, inv_inv]
        constructor
        · intro hg
          have he : γ * (γ⁻¹ * g * γ) * γ⁻¹ = g := by group
          simpa only [he] using G.mul_mem (G.mul_mem hγG hg) (G.inv_mem hγG)
        · intro hg
          exact G.mul_mem (G.mul_mem (G.inv_mem hγG) hg) hγG
      change γ ∈ Subgroup.Commensurable.commensurator G
      rw [Subgroup.Commensurable.commensurator_mem_iff, hconj]
    · obtain rfl := Set.mem_singleton_iff.mp hγ
      exact h.mobius_lift_neg_mem_commensurator hd
  · intro τ τ'
    constructor
    · intro hx
      rcases WeierstrassCurve.Affine.Y_eq_of_X_eq (h.mem τ) (h.mem τ') hx with hy | hy
      · obtain ⟨γ, hγ, hmove⟩ := (h.fibre τ τ').mp (Prod.ext hx hy)
        exact ⟨γ, hGΓ hγ, hmove⟩
      · have heq : π τ = π (d • τ' : ℍ) := by
          rw [hd]
          exact Prod.ext hx hy
        obtain ⟨γ, hγ, hmove⟩ := (h.fibre τ (d • τ')).mp heq
        exact ⟨d⁻¹ * γ, Γ.mul_mem (Γ.inv_mem hdΓ) (hGΓ hγ),
          by rw [mul_smul, hmove, inv_smul_smul]⟩
    · rintro ⟨γ, hγ, rfl⟩
      exact (hΓfst hγ τ).symm

end AbcAdaptation.Reference.Iut.Anabelian.CanLiftAnalytic.IsUniformization
