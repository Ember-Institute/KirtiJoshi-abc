import Solutions.Source_TripodRationalLegendreFive
import Solutions.Source_TripodFinitePlaceArithmetic
import Mathlib.NumberTheory.Padics.HeightOneSpectrum
import Lean.Elab.Tactic.Omega

set_option autoImplicit false

namespace AbcAdaptation.Tripod

open NumberField IsDedekindDomain WithZero
open scoped WithZero

local instance rationalFivePlacePrime : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩

private def fivePrime : Nat.Primes := ⟨5, Nat.prime_five⟩

private noncomputable def fiveIdeal : HeightOneSpectrum (𝓞 ℚ) :=
  (Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)).symm fivePrime

/-- The finite place of the rational field with prime ideal generated by `5`. -/
noncomputable def rationalFivePlace : FinitePlace ℚ := FinitePlace.mk fiveIdeal

private theorem fiveIdeal_span : fiveIdeal.asIdeal = Ideal.span {(5 : 𝓞 ℚ)} := by
  let e := Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)
  have hgen : Rat.HeightOneSpectrum.natGenerator fiveIdeal = 5 :=
    congrArg (fun p : Nat.Primes => (p : ℕ))
      ((Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)).apply_symm_apply fivePrime)
  have hmap : fiveIdeal.asIdeal.map e = Ideal.span {(5 : ℤ)} := by
    calc
      _ = Ideal.span {(Rat.HeightOneSpectrum.natGenerator fiveIdeal : ℤ)} :=
        (Rat.HeightOneSpectrum.span_natGenerator fiveIdeal).symm
      _ = _ := by rw [hgen, Nat.cast_ofNat]
  calc
    fiveIdeal.asIdeal = (fiveIdeal.asIdeal.map e).comap e :=
      (Ideal.comap_map_of_bijective e.toRingHom e.bijective).symm
    _ = (Ideal.span {(5 : ℤ)}).comap e := by rw [hmap]
    _ = Ideal.span {(5 : 𝓞 ℚ)} := by
      rw [← Ideal.map_symm e, Ideal.map_span, Set.image_singleton, map_ofNat]

private theorem fiveIdeal_absNorm : Ideal.absNorm fiveIdeal.asIdeal = 5 := by
  simpa only [fiveIdeal_span, Nat.cast_ofNat, RingOfIntegers.rank, Module.finrank_self, pow_one]
    using (Ideal.absNorm_span_natCast (S := 𝓞 ℚ) 5)

private theorem fiveIdeal_valuation_eq (y : ℚ) (hy : y ≠ 0) :
    fiveIdeal.valuation ℚ y = WithZero.exp (-padicValRat 5 y) := by
  have hcomp : (fiveIdeal.valuation ℚ).IsEquiv (Rat.padicValuation 5) := by
    have hprime : Rat.HeightOneSpectrum.primesEquiv fiveIdeal = fivePrime :=
      (Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)).apply_symm_apply fivePrime
    exact (congrArg (fun p : Nat.Primes =>
      (fiveIdeal.valuation ℚ).IsEquiv (@Rat.padicValuation (p : ℕ) ⟨p.2⟩)) hprime).mp
      (Rat.HeightOneSpectrum.valuation_equiv_padicValuation fiveIdeal)
  have hfive : fiveIdeal.valuation ℚ (5 : ℚ) = WithZero.exp (-1 : ℤ) := by
    rw [show (5 : ℚ) = algebraMap (𝓞 ℚ) ℚ 5 by rw [map_ofNat],
      HeightOneSpectrum.valuation_of_algebraMap]
    exact fiveIdeal.intValuation_singleton (by norm_num) fiveIdeal_span
  have hpadic : Rat.padicValuation 5 y = WithZero.exp (-padicValRat 5 y) := by
    change (if y = 0 then 0 else WithZero.exp (-padicValRat 5 y)) = _
    rw [if_neg hy]
  have hpow : ∀ (v : Valuation ℚ ℤᵐ⁰), v 5 = WithZero.exp (-1 : ℤ) →
      v ((5 : ℚ) ^ padicValRat 5 y) = WithZero.exp (-padicValRat 5 y) := by
    intro v hv
    rw [map_zpow₀, hv, ← WithZero.exp_zsmul, Int.zsmul_eq_mul, mul_neg_one]
  have hself : Rat.padicValuation 5 (5 : ℚ) = WithZero.exp (-1 : ℤ) := by
    simpa only [Nat.cast_ofNat] using Rat.padicValuation_self 5
  have hrat : Rat.padicValuation 5 ((5 : ℚ) ^ padicValRat 5 y) =
      Rat.padicValuation 5 y := by
    rw [hpow _ hself, hpadic]
  have hadic : fiveIdeal.valuation ℚ ((5 : ℚ) ^ padicValRat 5 y) =
      fiveIdeal.valuation ℚ y := hcomp.eq_iff.mpr hrat
  rw [← hadic, hpow _ hfive]

/-- The `5`-adic norm of this rational Legendre `j`-invariant as a finite-place norm. -/
theorem rationalFivePlace_legendreJ (m : ℕ) (hm : 0 < m) :
    rationalFivePlace (legendreJ (rationalLegendreFiveParam m)) = (5 : ℝ) ^ (2 * m) := by
  let j := legendreJ (rationalLegendreFiveParam m)
  have hjVal : padicValRat 5 j = -(2 * (m : ℤ)) :=
    padicValRat_legendreJ_rationalLegendreFiveParam m hm
  have hj : j ≠ 0 := by
    intro hj
    rw [hj, padicValRat.zero] at hjVal
    have hmZ : (0 : ℤ) < m := by exact_mod_cast hm
    omega
  have hv : fiveIdeal.valuation ℚ j = WithZero.exp ((2 * m : ℕ) : ℤ) := by
    rw [fiveIdeal_valuation_eq j hj, hjVal, neg_neg, Nat.cast_mul, Nat.cast_ofNat]
  change FinitePlace.mk fiveIdeal j = _
  rw [FinitePlace.mk_apply, FinitePlace.norm_embedding', hv,
    WithZeroMulInt.toNNReal_neg_apply _ WithZero.exp_ne_zero]
  have hunzero :
      (WithZero.unzero (WithZero.exp_ne_zero (a := ((2 * m : ℕ) : ℤ)))).toAdd =
        ((2 * m : ℕ) : ℤ) := rfl
  rw [hunzero, NNReal.coe_zpow, NNReal.coe_natCast, fiveIdeal_absNorm,
    Nat.cast_ofNat, zpow_natCast]

theorem residueChar_rationalFivePlace : residueChar rationalFivePlace = 5 := by
  have hp := residueChar_prime rationalFivePlace
  change (ringChar (𝓞 ℚ ⧸ rationalFivePlace.maximalIdeal.asIdeal)).Prime at hp
  change ringChar (𝓞 ℚ ⧸ rationalFivePlace.maximalIdeal.asIdeal) = 5
  rw [show rationalFivePlace.maximalIdeal = fiveIdeal from FinitePlace.maximalIdeal_mk _,
    fiveIdeal_span] at hp ⊢
  let I : Ideal (𝓞 ℚ) := Ideal.span {(5 : 𝓞 ℚ)}
  change ringChar (𝓞 ℚ ⧸ I) = 5
  have hmem : (5 : 𝓞 ℚ) ∈ I := Ideal.subset_span (Set.mem_singleton _)
  have hz : ((5 : ℕ) : 𝓞 ℚ ⧸ I) = 0 := by
    rw [Nat.cast_ofNat, ← map_ofNat (Ideal.Quotient.mk I), Ideal.Quotient.eq_zero_iff_mem]
    exact hmem
  have hdvd : ringChar (𝓞 ℚ ⧸ I) ∣ 5 := (ringChar.spec (𝓞 ℚ ⧸ I) 5).mp hz
  exact (Nat.prime_dvd_prime_iff_eq hp Nat.prime_five).mp hdvd

end AbcAdaptation.Tripod
