import Solutions.Source_ReferenceIutCanLiftFricke
import Solutions.Source_ReferenceIutCanLiftLatticeComplement
import Solutions.Source_ReferenceIutCanLiftLatticeEdgePairings
import Solutions.Source_ReferenceIutCanLiftTakeuchiModularLift

set_option autoImplicit false

open AbcAdaptation.Reference.Heights (modularJ periodPair)
open Set
open scoped MatrixGroups UpperHalfPlane

namespace AbcAdaptation.Reference.Iut.Anabelian.CanLiftAnalytic.Takeuchi

open Fricke (tr tr_def tr_mul_comm tr_mul_mul_self tr_one)

private theorem tr_sq_eq (γ : SL(2, ℝ)) : tr (γ * γ) = tr γ ^ 2 - 2 := by
  simpa only [mul_one, tr_one, pow_two] using tr_mul_mul_self γ (1 : SL(2, ℝ))

private theorem tr_conj (m γ : SL(2, ℝ)) : tr (m * γ * m⁻¹) = tr γ := by
  rw [tr_mul_comm (m * γ) m⁻¹, ← mul_assoc, inv_mul_cancel, one_mul]

/-- A real special linear matrix preserving modular `j` has integral trace. -/
theorem exists_int_tr_of_modularJ {M : SL(2, ℝ)}
    (hM : ∀ τ : ℍ, modularJ (M • τ) = modularJ τ) : ∃ n : ℤ, tr M = n := by
  obtain ⟨δ, hδ⟩ := exists_SL2Z_eq_of_modularJ (holomorphicH_smul M) hM
  have hfix : ∀ τ : ℍ, ((toSLR δ)⁻¹ * M) • τ = τ := fun τ ↦ by
    rw [mul_smul, hδ τ, inv_smul_smul]
  let n : ℤ := δ 0 0 + δ 1 1
  have hn : tr (toSLR δ) = n := by
    simp only [n, tr_def, Int.cast_add] <;> rfl
  rcases eq_one_or_neg_one_of_forall hfix with h | h
  · rw [inv_mul_eq_one] at h
    exact ⟨n, by rw [← h, hn]⟩
  · have hneg : M = -toSLR δ := by
      simpa only [inv_mul_eq_iff_eq_mul, mul_neg_one] using h
    refine ⟨-n, ?_⟩
    rw [hneg, Int.cast_neg]
    simpa only [tr, Matrix.SpecialLinearGroup.coe_neg, Matrix.trace_neg] using congrArg Neg.neg hn

/-- A `2Λ`-periodic orbifold covering of the modular line on `ℂ ∖ Λ` gives integral squared
traces for the entire subgroup generated by the two edge pairings. -/
theorem int_sq_traces (hL : OrbLiftStatement) (hJ : JOrbStatement) (τ₀ : ℍ) {F : ℂ → ℂ}
    (hFo : IsOrbCover F ((periodPair τ₀).lattice : Set ℂ)ᶜ sig)
    (hFl : ∀ u ∉ (periodPair τ₀).lattice, HasLocalForm F u (sig (F u)))
    (hFp : ∀ u, ∀ l ∈ (periodPair τ₀).lattice, F (u + 2 * l) = F u) :
    ∀ γ ∈ Subgroup.closure {Generators.A (latticeComplementCover (periodPair τ₀)),
      Generators.B (latticeComplementCover (periodPair τ₀))}, ∃ n : ℤ, tr γ ^ 2 = n := by
  let U := latticeComplementCover (periodPair τ₀)
  obtain ⟨m, hm⟩ := exists_mobius_lift_of_orbifold hL hJ U hFo hFl
  intro γ hγ
  have hΓ : γ ∈ U.deckGroup := by
    refine (Subgroup.closure_le _).mpr ?_ hγ
    intro g hg
    simp only [mem_insert_iff, mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    exacts [Generators.A_mem U, Generators.B_mem U]
  obtain ⟨l, hl, hγl⟩ := (U.mem_deckGroup).mp hΓ
  have hγ2 : ∀ τ : ℍ, F (U.ψ ((γ * γ) • τ)) = F (U.ψ τ) := fun τ ↦ by
    rw [mul_smul, hγl, hγl, add_assoc, ← two_mul]
    exact hFp (U.ψ τ) l hl
  have hM : ∀ σ : ℍ, modularJ ((m * (γ * γ) * m⁻¹) • σ) = modularJ σ := by
    intro σ
    obtain ⟨τ, rfl⟩ : ∃ τ, σ = m • τ := ⟨m⁻¹ • σ, by rw [smul_inv_smul]⟩
    rw [mul_smul, mul_smul, inv_smul_smul, hm ((γ * γ) • τ), hm τ, hγ2]
  obtain ⟨n, hn⟩ := exists_int_tr_of_modularJ hM
  rw [tr_conj, tr_sq_eq, sub_eq_iff_eq_add] at hn
  exact ⟨n + 2, by simpa using hn⟩

end AbcAdaptation.Reference.Iut.Anabelian.CanLiftAnalytic.Takeuchi
