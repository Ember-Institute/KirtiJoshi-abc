import Solutions.Source_ReferenceIutCor312KummerCrystallineBridge
import ArithmeticTeichmullerSpaces.Act1Scene1.PadicTiltField

set_option autoImplicit false

namespace JoshiTeich.Act1Scene1.CrystallineEnvelope

universe u v

noncomputable section

variable (p : ℕ) [Fact p.Prime]

local notation "Cₚ" => PadicComplex p
local notation "𝒪ₚ" => LocalGeometricFontaine.integerRing Cₚ

/-- The crystalline completion over the standard p-adic complex field. -/
def PadicACris : Type := ACris Cₚ p

/-- The pretilt used by the standard p-adic crystalline logarithm. -/
def PadicPreTilt : Type := GeometricTiltField.Source Cₚ p

/-- The Teichmüller difference of the pretilt element belongs to the Fontaine
kernel plus the ideal generated by the prime. -/
def isPadicLogInput (x : PadicPreTilt p) : Prop :=
  teichmullerSubOne Cₚ p x ∈ kerSupPrime Cₚ p

section RootTower

variable {K : Type u} [Field K] {Ω : Type v} [Field Ω] [Algebra K Ω]
variable {a : K}

/-- Reduce the integral coordinates of the original root tower modulo the prime. -/
def padicKummerPreTilt :=
  @LocalKummer.RootTower.toGeometricPreTilt K _ Ω _ _
    (PadicComplex p) (PadicComplex.normedField p) (PadicComplex.isUltrametricDist p)
    p _ a

/-- The original tower has an integral logarithm input. -/
theorem isPadicLogInput_padicKummerPreTilt
    (R : LocalKummer.RootTower (Ω := Ω) p a) (j : Ω →+* PadicComplex p)
    (ha : ‖(j (algebraMap K Ω a) : PadicComplex p)‖ ≤ 1)
    (hu : ∃ r : 𝒪ₚ, j (algebraMap K Ω a) = (1 + (p : Cₚ) * (r : Cₚ) : Cₚ)) :
    isPadicLogInput p (padicKummerPreTilt p R j ha) :=
  @kummerTeichmullerSubOne_mem_kerSupPrime (PadicComplex p) (PadicComplex.normedField p)
    (PadicComplex.isUltrametricDist p) (inferInstance : CompleteSpace (PadicComplex p))
    p _ (PadicTiltField.primeNormFact p) K _ Ω _ _ a R j ha hu (PadicComplex.isAlgClosed p)

/-- Keep the pretilt element and its Fontaine ideal membership together when specializing the tower. -/
def padicKummerLogInput
    (R : LocalKummer.RootTower (Ω := Ω) p a) (j : Ω →+* PadicComplex p)
    (ha : ‖(j (algebraMap K Ω a) : PadicComplex p)‖ ≤ 1)
    (hu : ∃ r : 𝒪ₚ, j (algebraMap K Ω a) = (1 + (p : Cₚ) * (r : Cₚ) : Cₚ)) :
    {x : PadicPreTilt p // isPadicLogInput p x} :=
  ⟨padicKummerPreTilt p R j ha, isPadicLogInput_padicKummerPreTilt p R j ha hu⟩

/-- The crystalline logarithm of the original tower of a principal unit in standard `ℂ_p`. -/
def padicKummerLog :=
  fun R j ha hu => @kummerLogOfExists (PadicComplex p) (PadicComplex.normedField p)
    (PadicComplex.isUltrametricDist p) (inferInstance : CompleteSpace (PadicComplex p))
    p _ (PadicTiltField.primeNormFact p) K _ Ω _ _ a R j ha hu (PadicComplex.isAlgClosed p)

end RootTower

end

end JoshiTeich.Act1Scene1.CrystallineEnvelope
