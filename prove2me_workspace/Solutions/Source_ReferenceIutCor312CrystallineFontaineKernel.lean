import Solutions.Source_ReferenceIutCor312CrystallineEnvelope
import ArithmeticTeichmullerSpaces.Act1Scene1.AdicKernelDivision
import ArithmeticTeichmullerSpaces.Act1Scene1.GeometricTiltIntegerRing

set_option autoImplicit false

namespace JoshiTeich.Act1Scene1.CrystallineEnvelope

open JoshiTeich.Prologue

noncomputable section

variable (C : Type*) [NormedField C] [IsUltrametricDist C] [CompleteSpace C] [IsAlgClosed C]
variable (p : ℕ) [Fact p.Prime] [Fact (0 < ‖(p : C)‖ ∧ ‖(p : C)‖ < 1)]

local notation "𝒪" => LocalGeometricFontaine.integerRing C
local notation "S" => GeometricTiltField.Source C p
local notation "F" => GeometricTiltField.FractionField C p
local notation "θ" => (Perfectoid.thetaMap (O := 𝒪) (p := p))

local instance tiltNorm : NormedField F := GeometricTiltNorm.fractionNormedField C p
local instance tiltUltrametric : IsUltrametricDist F := GeometricTiltNorm.fractionUltrametric C p

/-- The tilt element determined by a compatible tower of integral roots of `p`. -/
def primeTilt : S := GeometricTiltSharp.rootLift C p (p : 𝒪)

/-- The Fontaine kernel generator on the same Witt ring used to construct `A0`. -/
def fontainePrimitive : Ainf C p := WittVector.teichmuller p (primeTilt C p) - p

theorem fontainePrimitive_mem_ker : fontainePrimitive C p ∈ RingHom.ker θ := by
  rw [RingHom.mem_ker, fontainePrimitive, map_sub, map_natCast,
    Perfectoid.thetaMap_teichmuller]
  change PreTilt.untilt (primeTilt C p) - (p : 𝒪) = 0
  rw [primeTilt, GeometricTiltSharp.untilt_rootLift, sub_self]

theorem fontainePrimitive_coeff_zero : (fontainePrimitive C p).coeff 0 = primeTilt C p := by
  change WittVector.constantCoeff (fontainePrimitive C p) = _
  rw [fontainePrimitive, map_sub, map_natCast, CharP.cast_eq_zero S p, sub_zero]
  exact WittVector.teichmuller_coeff_zero p (primeTilt C p)

private theorem primeTilt_norm : ‖primeTilt C p‖ = ‖(p : C)‖ := by
  rw [GeometricPreTiltCompleteness.norm_eq_valuation,
    GeometricTiltSharp.sourceValuation_eq_sharp_norm]
  change ‖GeometricTiltSharp.integralSharp C p (primeTilt C p)‖ = ‖(p : C)‖
  rw [primeTilt, GeometricTiltSharp.integralSharp_rootLift, Subring.coe_natCast]

theorem fontainePrimitive_ne_zero : fontainePrimitive C p ≠ 0 := by
  intro h
  have hz := congrArg (fun x : Ainf C p => ‖x.coeff 0‖) h
  change ‖(fontainePrimitive C p).coeff 0‖ = ‖(0 : Ainf C p).coeff 0‖ at hz
  rw [fontainePrimitive_coeff_zero, primeTilt_norm, WittVector.zero_coeff, norm_zero] at hz
  exact (Fact.out : 0 < ‖(p : C)‖ ∧ ‖(p : C)‖ < 1).1.ne' hz

private theorem primeTilt_dvd_coeff_zero (x : Ainf C p) (hx : x ∈ RingHom.ker θ) :
    primeTilt C p ∣ x.coeff 0 := by
  have hred : PreTilt.coeff 0 (x.coeff 0) = 0 := by
    rw [← WittVector.mk_fontaineTheta]
    change Ideal.Quotient.mk _ (θ x) = 0
    rw [RingHom.mem_ker.mp hx, map_zero]
  have hn := (GeometricPreTiltCompleteness.coeff_eq_zero_iff C p (x.coeff 0) 0).mp hred
  rw [pow_zero, pow_one, ← primeTilt_norm C p] at hn
  let e := GeometricTiltIntegerRing.preTiltEquiv C p
  have hd : e (primeTilt C p) ∣ e (x.coeff 0) := by
    apply (Valuation.integer.integers (NormedField.valuation (K := F))).dvd_of_le
    change ‖(e (x.coeff 0) : F)‖₊ ≤ ‖(e (primeTilt C p) : F)‖₊
    apply NNReal.coe_le_coe.mp
    change ‖(e (x.coeff 0) : F)‖ ≤ ‖(e (primeTilt C p) : F)‖
    exact (GeometricTiltIntegerRing.preTiltEquiv_norm C p (x.coeff 0)).trans_le
      (hn.trans_eq (GeometricTiltIntegerRing.preTiltEquiv_norm C p (primeTilt C p)).symm)
  obtain ⟨b, hb⟩ := hd
  refine ⟨e.symm b, e.injective ?_⟩
  rw [map_mul, RingEquiv.apply_symm_apply, hb]

/-- The actual Fontaine kernel is generated by the displayed primitive. -/
theorem fontaineKernel_eq_span : RingHom.ker θ = Ideal.span {fontainePrimitive C p} := by
  apply AdicKernelDivision.eq_span (p : Ainf C p) (fontainePrimitive C p) _
    (fontainePrimitive_mem_ker C p)
  intro x
  obtain ⟨b, hb⟩ := primeTilt_dvd_coeff_zero C p x.1 x.2
  let t := WittVector.teichmuller p b
  have hv : (x.1 - fontainePrimitive C p * t).coeff 0 = 0 := by
    change WittVector.constantCoeff (x.1 - fontainePrimitive C p * t) = 0
    rw [map_sub, map_mul]
    change x.1.coeff 0 - (fontainePrimitive C p).coeff 0 * t.coeff 0 = 0
    rw [fontainePrimitive_coeff_zero, sub_eq_zero]
    exact hb
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp
    ((WittVector.mem_span_p_iff_coeff_zero_eq_zero _).mpr hv)
  have he := congrArg θ hr
  rw [map_sub, map_mul, RingHom.mem_ker.mp x.2,
    RingHom.mem_ker.mp (fontainePrimitive_mem_ker C p), zero_mul, sub_zero,
    map_mul, map_natCast] at he
  have hp : (p : 𝒪) ≠ 0 := by
    intro hz
    exact (norm_pos_iff.mp (Fact.out : 0 < ‖(p : C)‖ ∧ ‖(p : C)‖ < 1).1)
      (congrArg (fun a : 𝒪 => (a : C)) hz)
  have hrKer : r ∈ RingHom.ker θ :=
    RingHom.mem_ker.mpr ((mul_eq_zero.mp he.symm).resolve_left hp)
  refine ⟨t, ⟨r, hrKer⟩, ?_⟩
  exact (sub_eq_iff_eq_add.mp hr).trans (add_comm _ _)

end

end JoshiTeich.Act1Scene1.CrystallineEnvelope
