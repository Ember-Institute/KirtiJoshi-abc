import Solutions.Source_ReferenceIutCor312CrystallineDividedPowers
import Solutions.Source_ReferenceIutCor312CrystallineInputs
import Solutions.Source_ReferenceIutCor312DividedPowerLog

/-!
The crystalline logarithms of the original Kummer and cyclotomic root towers.
The coefficients lie in the subalgebra generated by the divided powers of
the Fontaine kernel. The compatible residues give elements of its p-adic
completion.
-/

set_option autoImplicit false

namespace JoshiTeich.Act1Scene1.CrystallineEnvelope

open JoshiTeich.Prologue

noncomputable section

universe u v w

variable (C : Type w) [NormedField C] [IsUltrametricDist C] [CompleteSpace C]
variable (p : ℕ) [Fact p.Prime] [Fact (0 < ‖(p : C)‖ ∧ ‖(p : C)‖ < 1)]

local notation "𝒪" => LocalGeometricFontaine.integerRing C
local notation "θ" => (Perfectoid.thetaMap (O := 𝒪) (p := p))

/-- The p-adic completion of the integral divided-power subalgebra. -/
abbrev ACris := AdicCompletion (Ideal.span {(p : A0 C p)}) (A0 C p)

/-- The crystalline logarithm of `1 + x` for a Witt vector congruent to
zero under the Fontaine map modulo the prime. -/
def logOfMemKerSupPrime (x : Ainf C p)
    (hx : x ∈ RingHom.ker θ ⊔ Ideal.span {(p : Ainf C p)}) : ACris C p :=
  DividedPowerLog.log p (Fact.out : p.Prime).pos
    (fun n => gammaInOfMemKerSupPrime C p n x hx)

theorem natCast_succ_mul_crystallineLogTerm (x : Ainf C p)
    (hx : x ∈ RingHom.ker θ ⊔ Ideal.span {(p : Ainf C p)}) (n : ℕ) :
    ((n + 1 : ℕ) : A0 C p) *
        DividedPowerLog.logTerm (fun m => gammaInOfMemKerSupPrime C p m x hx) n =
      (-1 : A0 C p) ^ n * (algebraMap (Ainf C p) (A0 C p) x) ^ (n + 1) :=
  DividedPowerLog.natCast_succ_mul_logTerm _ n
    (factorial_mul_gammaInOfMemKerSupPrime C p (n + 1) x hx)

/-- Modulo `p^k`, every truncation with at least `p * k` terms represents
the same crystalline logarithm. -/
theorem eval_logOfMemKerSupPrime (x : Ainf C p)
    (hx : x ∈ RingHom.ker θ ⊔ Ideal.span {(p : Ainf C p)})
    {k N : ℕ} (hN : p * k ≤ N) :
    AdicCompletion.evalₐ (Ideal.span {(p : A0 C p)}) k (logOfMemKerSupPrime C p x hx) =
      Ideal.Quotient.mk (Ideal.span {(p : A0 C p)} ^ k)
        (DividedPowerLog.logPartialSum (fun m => gammaInOfMemKerSupPrime C p m x hx) N) :=
  DividedPowerLog.eval_log_of_le p (Fact.out : p.Prime).pos _ hN

/-- The integral logarithm of the Teichmüller lift of the original
cyclotomic tower. -/
def cyclotomicLog (ε : LocalKummer.cyclotomicTateGroup p C) : ACris C p := by
  have hle : RingHom.ker θ ≤ RingHom.ker θ ⊔ Ideal.span {(p : Ainf C p)} := le_sup_left
  exact logOfMemKerSupPrime C p
    (WittVector.teichmuller p (CyclotomicTateTilt.toPreTilt C p ε) - 1)
    (hle (LocalKummer.RootTower.cyclotomic_teichmuller_sub_one_mem_theta_ker ε))

variable {K : Type u} [Field K] {Ω : Type v} [Field Ω] [Algebra K Ω]
variable [IsAlgClosed C]

/-- The integral logarithm of the Teichmüller lift of the original root tower
of a principal unit. -/
def kummerLog {a : K} (R : LocalKummer.RootTower (Ω := Ω) p a) (j : Ω →+* C)
    (ha : ‖j (algebraMap K Ω a)‖ ≤ 1) (r : 𝒪)
    (hu : j (algebraMap K Ω a) = 1 + (p : C) * (r : C)) : ACris C p :=
  logOfMemKerSupPrime C p
    (WittVector.teichmuller p (LocalKummer.RootTower.toGeometricPreTilt R j ha) - 1)
    (LocalKummer.RootTower.teichmuller_sub_one_mem_theta_ker_sup_prime R j ha r hu)

end

end JoshiTeich.Act1Scene1.CrystallineEnvelope
